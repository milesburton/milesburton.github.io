---
import Layout from '../../layouts/Layout.astro';

const updated = new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'long', year: 'numeric' }).format(new Date('2026-08-02'));

const cards = [
	{
		kicker: 'AI & Local Compute',
		title: 'Local AI infrastructure',
		description:
			'Experimenting with an Nvidia DGX and a 5070 Ti for running models locally — working out what’s actually worth self-hosting versus using a hosted API, and where the latency/privacy trade-off pays off.',
	},
	{
		kicker: 'Amateur Radio',
		title: 'Mesh radio & MeshCore nodes',
		description:
			'Building out MeshCore nodes, mapping coverage, and working through the infrastructure needed to run a resilient local mesh network.',
	},
	{
		kicker: 'Trading & Simulation',
		title: 'VETA and fintech engagement',
		description:
			'Continued work on VETA, the paper-trading platform, alongside ongoing conversations with fintechs and investment banks about market simulation and trading infrastructure.',
	},
];
---

<Layout title="Now" description="What Miles Burton is currently working on.">
	<main class="shell">
		<header class="page-header">
			<p class="kicker">Currently</p>
			<h1>Now</h1>
			<p class="intro">
				What I'm actively spending time on. Updated {updated}. See{' '}
				<a href="https://nownownow.com/about" target="_blank" rel="noreferrer">nownownow.com</a> for the idea behind
				this page.
			</p>
		</header>

		<ul class="now-list">
			{cards.map((card) => (
				<li class="now-card">
					<p class="now-kicker">{card.kicker}</p>
					<h2>{card.title}</h2>
					<p class="now-description">{card.description}</p>
					<p class="now-note">Writing this up soon — check back for a link.</p>
				</li>
			))}
		</ul>
	</main>
</Layout>

<style>
	.shell {
		max-width: 780px;
		margin: 0 auto;
		padding: 4rem 2rem 5rem;
	}

	.page-header {
		margin-bottom: 2.5rem;
	}

	.kicker {
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--accent-strong);
		font-size: 0.78rem;
		font-weight: 600;
		margin: 0 0 0.75rem;
	}

	h1 {
		font-size: clamp(1.9rem, 4vw, 2.6rem);
		margin: 0;
	}

	.intro {
		margin-top: 0.85rem;
		max-width: 62ch;
		color: var(--text-muted);
		line-height: 1.6;
	}

	.intro a {
		color: var(--accent-strong);
		text-decoration: none;
	}

	.intro a:hover {
		text-decoration: underline;
	}

	.now-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 1rem;
	}

	.now-card {
		background: var(--bg-card);
		border: 1px solid var(--border);
		border-radius: 10px;
		padding: 1.25rem 1.5rem;
	}

	.now-kicker {
		font-size: 0.7rem;
		font-weight: 700;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--accent-strong);
		margin: 0 0 0.5rem;
	}

	.now-card h2 {
		margin: 0 0 0.6rem;
		font-size: 1.1rem;
		color: var(--text);
	}

	.now-description {
		margin: 0 0 0.85rem;
		color: var(--text-muted);
		font-size: 0.92rem;
		line-height: 1.55;
	}

	.now-note {
		margin: 0;
		color: var(--text-dim);
		font-size: 0.8rem;
		font-style: italic;
	}
</style>
