---
import fs from 'node:fs';
import path from 'node:path';
import Layout from '../../layouts/Layout.astro';
import Carousel from '../../components/Carousel.astro';
import PageHeader from '../../components/PageHeader.astro';
import PostCard from '../../components/PostCard.astro';
import { fetchOwnedRepos } from '../../lib/github';
import { formatMonthYear } from '../../lib/format';

// Thumbnails are pre-fetched from GitHub's OpenGraph card service and
// committed to public/project-media/ via scripts/fetch-project-thumbnails.mjs
// -- that endpoint rate-limits hard (~100 req/window), far below what fetching
// all ~73 repos live on every build would need, so this reads local files
// instead. Re-run the script when repos are added/renamed.
const thumbnailManifest: Record<string, unknown> = JSON.parse(
	fs.readFileSync(path.join(process.cwd(), 'public', 'project-media', 'manifest.json'), 'utf-8'),
);

// A handful of flagship repos have a real hand-picked screenshot (used on the
// homepage's Featured Projects) rather than GitHub's generic repo-name card --
// prefer those here too so this page doesn't show a worse thumbnail for the
// same repo than the homepage does.
const curatedImages: Record<string, string> = {
	'Arduino-Temperature-Control-Library': '/images/projects/arduino-dashboard.jpg',
	'veta-trading-platform': '/images/projects/veta-dashboard.jpg',
	teslacam: '/images/projects/teslacam.jpg',
};

function thumbnailFor(name: string): string | null {
	if (curatedImages[name]) return curatedImages[name];
	return name in thumbnailManifest ? `/project-media/${name}.jpg` : null;
}

// Manual overrides for repos with a live deployment separate from GitHub's
// `homepage` field (which is unset or points at decommissioned properties).
const liveLinks: Record<string, string> = {
	'veta-trading-platform': 'https://veta.mnetcs.com/',
};

const repos = await fetchOwnedRepos('milesburton');

repos.sort((a, b) => {
	if (b.stargazers_count !== a.stargazers_count) return b.stargazers_count - a.stargazers_count;
	return new Date(b.pushed_at).valueOf() - new Date(a.pushed_at).valueOf();
});

// Hand-picked flagship repos for the carousel. Uses GitHub's OpenGraph card
// image service, which rate-limits hard (~100 req/window) — fine for this
// small, rarely-reloaded set, but NOT used for the full list below.
const featuredNames = ['Arduino-Temperature-Control-Library', 'teslacam', 'HT1632', 'Android-Configuration-Manager', 'aprs-station-map', 'veta-trading-platform'];
const featured = featuredNames
	.map((name) => {
		const repo = repos.find((r) => r.name === name);
		if (!repo) return null;
		return {
			name: repo.name,
			description: repo.description,
			href: liveLinks[repo.name] ?? repo.html_url,
			image: thumbnailFor(repo.name) ?? `https://opengraph.githubassets.com/1/milesburton/${repo.name}`,
		};
	})
	.filter((item): item is NonNullable<typeof item> => item !== null);

const carouselSlides = featured.map((item) => ({
	href: item.href,
	image: item.image,
	alt: `${item.name} repository preview`,
	caption: item.name,
	external: true,
}));

const projectsSchema = {
	'@context': 'https://schema.org',
	'@type': 'ItemList',
	itemListElement: repos.map((repo, i) => ({
		'@type': 'ListItem',
		position: i + 1,
		item: {
			'@type': 'SoftwareSourceCode',
			name: repo.name,
			description: repo.description ?? undefined,
			codeRepository: repo.html_url,
			programmingLanguage: repo.language ?? undefined,
			url: repo.html_url,
		},
	})),
};
---

<Layout title="Projects" description="Open-source projects and libraries by Miles Burton." structuredData={projectsSchema}>
	<main class="shell">
		<PageHeader kicker="Engineering" title="Projects">
			<Fragment slot="intro">
				{repos.length > 0 ? `All ${repos.length} public repositories` : 'Public repositories'}, pulled
				directly from <a href="https://github.com/milesburton" target="_blank" rel="noreferrer">GitHub</a>,
				sorted by stars, then most recently active.
			</Fragment>
		</PageHeader>

		<Carousel id="projects-carousel" slides={carouselSlides} />

		<ul class="post-list">
			{repos.map((project) => (
				<PostCard href={project.html_url} image={thumbnailFor(project.name)} title={project.name} external>
					{liveLinks[project.name] && (
						<a href={liveLinks[project.name]} target="_blank" rel="noreferrer" class="live-link" slot="title-extra">
							Live site &rarr;
						</a>
					)}
					{project.description && <p class="post-excerpt" slot="excerpt">{project.description}</p>}
					<ul class="post-tags" slot="tags">
						{project.language && <li>{project.language}</li>}
						{project.stargazers_count > 0 && <li>&#9733; {project.stargazers_count}</li>}
						<li class="muted">Updated {formatMonthYear(project.pushed_at)}</li>
					</ul>
				</PostCard>
			))}
		</ul>
	</main>
</Layout>

<style>
	.live-link {
		font-size: 0.82rem;
		font-weight: 600;
		text-decoration: none;
		color: var(--accent-strong);
	}

	.live-link:hover {
		color: var(--accent);
	}

	.post-excerpt {
		margin: 0.4rem 0 0.7rem;
		color: var(--text-muted);
		font-size: 0.92rem;
		line-height: 1.55;
	}

	.post-tags {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
	}

	.post-tags li {
		font-size: 0.72rem;
		font-weight: 600;
		letter-spacing: 0.03em;
		color: var(--text-dim);
		background: var(--bg-raised);
		border: 1px solid var(--border);
		border-radius: 999px;
		padding: 0.2rem 0.6rem;
	}

	.post-tags li.muted {
		background: transparent;
		border-color: transparent;
		padding-left: 0;
		font-weight: 500;
	}

	@media (max-width: 560px) {
		.post-thumb {
			width: 72px;
			height: 72px;
		}
	}
</style>
