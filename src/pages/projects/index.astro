---
import Layout from '../../layouts/Layout.astro';

interface Repo {
	name: string;
	html_url: string;
	description: string | null;
	language: string | null;
	stargazers_count: number;
	pushed_at: string;
	fork: boolean;
	private: boolean;
	archived: boolean;
}

// Manual overrides for repos with a live deployment separate from GitHub's
// `homepage` field (which is unset or points at decommissioned properties).
const liveLinks: Record<string, string> = {
	'veta-trading-platform': 'https://veta.mnetcs.com/',
};

let repos: Repo[] = [];
try {
	const all: Repo[] = [];
	for (let page = 1; page <= 10; page++) {
		const res = await fetch(`https://api.github.com/users/milesburton/repos?per_page=100&type=owner&page=${page}`);
		if (!res.ok) break;
		const batch = (await res.json()) as Repo[];
		all.push(...batch);
		if (batch.length < 100) break;
	}
	repos = all.filter((r) => !r.fork && !r.private && !r.archived);
} catch {
	// build-time fetch failure — page renders with an empty list rather than failing the build
}

repos.sort((a, b) => {
	if (b.stargazers_count !== a.stargazers_count) return b.stargazers_count - a.stargazers_count;
	return new Date(b.pushed_at).valueOf() - new Date(a.pushed_at).valueOf();
});

const formatter = new Intl.DateTimeFormat('en-GB', { month: 'short', year: 'numeric' });

// Hand-picked flagship repos for the carousel. Uses GitHub's OpenGraph card
// image service, which rate-limits hard (~100 req/window) — fine for this
// small, rarely-reloaded set, but NOT used for the full list below.
const featuredNames = ['Arduino-Temperature-Control-Library', 'teslacam', 'HT1632', 'Android-Configuration-Manager', 'aprs-station-map', 'veta-trading-platform'];
const featured = featuredNames
	.map((name) => {
		const repo = repos.find((r) => r.name === name);
		if (!repo) return null;
		return {
			name: repo.name,
			description: repo.description,
			href: liveLinks[repo.name] ?? repo.html_url,
			image: `https://opengraph.githubassets.com/1/milesburton/${repo.name}`,
		};
	})
	.filter((item): item is NonNullable<typeof item> => item !== null);
---

<Layout title="GitHub Projects" description="Open-source projects and libraries by Miles Burton.">
	<main class="shell">
		<header class="page-header">
			<p class="kicker">Engineering</p>
			<h1>GitHub Projects</h1>
			<p class="intro">
				{repos.length > 0 ? `All ${repos.length} public repositories` : 'Public repositories'}, pulled
				directly from <a href="https://github.com/milesburton" target="_blank" rel="noreferrer">GitHub</a>,
				sorted by stars, then most recently active.
			</p>
		</header>

		{featured.length > 0 && (
			<div class="carousel" id="projects-carousel">
				<div class="carousel-track" id="carousel-track">
					{featured.map((item) => (
						<a href={item.href} target="_blank" rel="noreferrer" class="carousel-slide">
							<img src={item.image} alt={`${item.name} repository preview`} loading="lazy" />
							<span class="carousel-caption">{item.name}</span>
						</a>
					))}
				</div>
				<button type="button" class="carousel-nav carousel-prev" id="carousel-prev" aria-label="Previous image">
					<svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
						<path d="M15 6l-6 6 6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
					</svg>
				</button>
				<button type="button" class="carousel-nav carousel-next" id="carousel-next" aria-label="Next image">
					<svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
						<path d="M9 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
					</svg>
				</button>
				<div class="carousel-dots" id="carousel-dots">
					{featured.map((_, i) => (
						<button type="button" class="carousel-dot" data-index={i} aria-label={`Go to slide ${i + 1}`}></button>
					))}
				</div>
			</div>
		)}

		<ul class="post-list">
			{repos.map((project) => (
				<li class="post-card">
					<span class="post-thumb post-thumb-placeholder">
						<svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
							<rect x="3" y="3" width="18" height="18" rx="2" fill="none" stroke="currentColor" stroke-width="1.5" />
							<circle cx="8.5" cy="8.5" r="1.5" fill="currentColor" />
							<path d="M21 15l-5-5-9 9" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
						</svg>
					</span>
					<div class="post-body">
						<div class="post-title-row">
							<a href={project.html_url} target="_blank" rel="noreferrer" class="post-title">
								{project.name}
							</a>
							{liveLinks[project.name] && (
								<a href={liveLinks[project.name]} target="_blank" rel="noreferrer" class="live-link">
									Live site &rarr;
								</a>
							)}
						</div>
						{project.description && <p class="post-excerpt">{project.description}</p>}
						<ul class="post-tags">
							{project.language && <li>{project.language}</li>}
							{project.stargazers_count > 0 && <li>&#9733; {project.stargazers_count}</li>}
							<li class="muted">Updated {formatter.format(new Date(project.pushed_at))}</li>
						</ul>
					</div>
				</li>
			))}
		</ul>
	</main>
</Layout>

<script>
	const track = document.getElementById('carousel-track') as HTMLDivElement | null;
	if (track) {
		const prevBtn = document.getElementById('carousel-prev') as HTMLButtonElement;
		const nextBtn = document.getElementById('carousel-next') as HTMLButtonElement;
		const dotsContainer = document.getElementById('carousel-dots') as HTMLDivElement;
		const dots = Array.from(dotsContainer.querySelectorAll<HTMLButtonElement>('.carousel-dot'));
		const slideCount = track.children.length;
		let index = 0;
		let timer: ReturnType<typeof setInterval> | undefined;

		function render() {
			track!.style.transform = `translateX(-${index * 100}%)`;
			dots.forEach((dot, i) => dot.classList.toggle('active', i === index));
		}

		function goTo(i: number) {
			index = (i + slideCount) % slideCount;
			render();
		}

		function startAutoplay() {
			stopAutoplay();
			timer = setInterval(() => goTo(index + 1), 5000);
		}

		function stopAutoplay() {
			if (timer) clearInterval(timer);
		}

		prevBtn.addEventListener('click', () => {
			goTo(index - 1);
			startAutoplay();
		});
		nextBtn.addEventListener('click', () => {
			goTo(index + 1);
			startAutoplay();
		});
		dots.forEach((dot, i) => {
			dot.addEventListener('click', () => {
				goTo(i);
				startAutoplay();
			});
		});

		const carousel = document.getElementById('projects-carousel') as HTMLDivElement;
		carousel.addEventListener('mouseenter', stopAutoplay);
		carousel.addEventListener('mouseleave', startAutoplay);

		render();
		startAutoplay();
	}
</script>

<style>
	.shell {
		max-width: 780px;
		margin: 0 auto;
		padding: 4rem 2rem 5rem;
	}

	.page-header {
		margin-bottom: 2.5rem;
	}

	.kicker {
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--accent-strong);
		font-size: 0.78rem;
		font-weight: 600;
		margin: 0 0 0.75rem;
	}

	h1 {
		font-size: clamp(1.9rem, 4vw, 2.6rem);
		margin: 0;
	}

	.intro {
		margin-top: 0.85rem;
		max-width: 60ch;
		color: var(--text-muted);
		line-height: 1.6;
	}

	.intro a {
		color: var(--accent-strong);
		text-decoration: none;
	}

	.intro a:hover {
		text-decoration: underline;
	}

	.carousel {
		position: relative;
		margin-bottom: 2.5rem;
		border-radius: 14px;
		overflow: hidden;
		border: 1px solid var(--border-strong);
		background: var(--bg-raised);
	}

	.carousel-track {
		display: flex;
		transition: transform 400ms ease;
	}

	.carousel-slide {
		position: relative;
		flex: 0 0 100%;
		display: block;
		aspect-ratio: 16 / 8;
		text-decoration: none;
		color: inherit;
	}

	.carousel-slide img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}

	.carousel-caption {
		position: absolute;
		left: 0;
		right: 0;
		bottom: 0;
		padding: 2.5rem 1.5rem 1rem;
		background: linear-gradient(180deg, transparent, rgba(0, 0, 0, 0.75));
		color: #fff;
		font-size: 1rem;
		font-weight: 600;
	}

	.carousel-nav {
		position: absolute;
		top: 50%;
		transform: translateY(-50%);
		display: flex;
		align-items: center;
		justify-content: center;
		width: 2.25rem;
		height: 2.25rem;
		border-radius: 50%;
		border: none;
		background: rgba(0, 0, 0, 0.45);
		color: #fff;
		cursor: pointer;
		transition: background 120ms ease;
	}

	.carousel-nav:hover {
		background: rgba(0, 0, 0, 0.65);
	}

	.carousel-prev {
		left: 0.75rem;
	}

	.carousel-next {
		right: 0.75rem;
	}

	.carousel-dots {
		position: absolute;
		bottom: 0.65rem;
		left: 50%;
		transform: translateX(-50%);
		display: flex;
		gap: 0.4rem;
	}

	.carousel-dot {
		width: 0.5rem;
		height: 0.5rem;
		border-radius: 50%;
		border: none;
		padding: 0;
		background: rgba(255, 255, 255, 0.5);
		cursor: pointer;
		transition: background 120ms ease, transform 120ms ease;
	}

	.carousel-dot.active {
		background: #fff;
		transform: scale(1.3);
	}

	.post-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 1.1rem;
	}

	.post-card {
		display: flex;
		gap: 1.1rem;
		border-bottom: 1px solid var(--border);
		padding-bottom: 1.1rem;
	}

	.post-thumb {
		flex: 0 0 auto;
		display: flex;
		align-items: center;
		justify-content: center;
		width: 100px;
		height: 72px;
		border-radius: 8px;
		border: 1px solid var(--border);
		background: var(--bg-raised);
	}

	.post-thumb-placeholder {
		color: var(--text-dim);
		border-style: dashed;
	}

	.post-body {
		flex: 1;
		min-width: 0;
	}

	.post-title-row {
		display: flex;
		align-items: baseline;
		gap: 1rem;
		flex-wrap: wrap;
	}

	.post-title {
		display: block;
		font-size: 1.05rem;
		font-weight: 600;
		text-decoration: none;
		color: var(--text);
		line-height: 1.4;
	}

	.post-title:hover {
		color: var(--accent-strong);
	}

	.live-link {
		font-size: 0.82rem;
		font-weight: 600;
		text-decoration: none;
		color: var(--accent-strong);
	}

	.live-link:hover {
		color: var(--accent);
	}

	.post-excerpt {
		margin: 0.4rem 0 0.7rem;
		color: var(--text-muted);
		font-size: 0.92rem;
		line-height: 1.55;
	}

	.post-tags {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
	}

	.post-tags li {
		font-size: 0.72rem;
		font-weight: 600;
		letter-spacing: 0.03em;
		color: var(--text-dim);
		background: var(--bg-raised);
		border: 1px solid var(--border);
		border-radius: 999px;
		padding: 0.2rem 0.6rem;
	}

	.post-tags li.muted {
		background: transparent;
		border-color: transparent;
		padding-left: 0;
		font-weight: 500;
	}

	@media (max-width: 560px) {
		.post-thumb {
			width: 72px;
			height: 72px;
		}
	}
</style>
