---
import Layout from '../../layouts/Layout.astro';

interface Repo {
	name: string;
	html_url: string;
	description: string | null;
	language: string | null;
	stargazers_count: number;
	pushed_at: string;
	fork: boolean;
	private: boolean;
	archived: boolean;
}

// Manual overrides for repos with a live deployment separate from GitHub's
// `homepage` field (which is unset or points at decommissioned properties).
const liveLinks: Record<string, string> = {
	'veta-trading-platform': 'https://veta.mnetcs.com/',
};

let repos: Repo[] = [];
try {
	const all: Repo[] = [];
	for (let page = 1; page <= 10; page++) {
		const res = await fetch(`https://api.github.com/users/milesburton/repos?per_page=100&type=owner&page=${page}`);
		if (!res.ok) break;
		const batch = (await res.json()) as Repo[];
		all.push(...batch);
		if (batch.length < 100) break;
	}
	repos = all.filter((r) => !r.fork && !r.private && !r.archived);
} catch {
	// build-time fetch failure — page renders with an empty list rather than failing the build
}

repos.sort((a, b) => {
	if (b.stargazers_count !== a.stargazers_count) return b.stargazers_count - a.stargazers_count;
	return new Date(b.pushed_at).valueOf() - new Date(a.pushed_at).valueOf();
});

const formatter = new Intl.DateTimeFormat('en-GB', { month: 'short', year: 'numeric' });
---

<Layout title="Projects" description="Open-source projects and libraries by Miles Burton.">
	<main class="shell">
		<header class="page-header">
			<p class="kicker">Engineering</p>
			<h1>GitHub Projects</h1>
			<p class="intro">
				{repos.length > 0 ? `All ${repos.length} public repositories` : 'Public repositories'}, pulled
				directly from <a href="https://github.com/milesburton" target="_blank" rel="noreferrer">GitHub</a>,
				sorted by stars, then most recently active.
			</p>
		</header>

		<ul class="project-list">
			{repos.map((project) => (
				<li class="project-card">
					<div class="project-heading">
						<a href={project.html_url} target="_blank" rel="noreferrer" class="project-name">
							{project.name}
						</a>
						{liveLinks[project.name] && (
							<a href={liveLinks[project.name]} target="_blank" rel="noreferrer" class="live-link">
								Live site &rarr;
							</a>
						)}
					</div>
					{project.description && <p class="project-description">{project.description}</p>}
					<ul class="tags">
						{project.language && <li>{project.language}</li>}
						{project.stargazers_count > 0 && <li>&#9733; {project.stargazers_count}</li>}
						<li class="muted">Updated {formatter.format(new Date(project.pushed_at))}</li>
					</ul>
				</li>
			))}
		</ul>
	</main>
</Layout>

<style>
	.shell {
		max-width: 860px;
		margin: 0 auto;
		padding: 4rem 2rem 5rem;
	}

	.page-header {
		margin-bottom: 2.5rem;
	}

	.kicker {
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--accent-strong);
		font-size: 0.78rem;
		font-weight: 600;
		margin: 0 0 0.75rem;
	}

	h1 {
		font-size: clamp(1.9rem, 4vw, 2.6rem);
		margin: 0;
	}

	.intro {
		margin-top: 0.85rem;
		max-width: 60ch;
		color: var(--text-muted);
		line-height: 1.6;
	}

	.intro a {
		color: var(--accent-strong);
		text-decoration: none;
	}

	.intro a:hover {
		text-decoration: underline;
	}

	.project-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 1rem;
	}

	.project-card {
		background: var(--bg-card);
		border: 1px solid var(--border);
		border-radius: 10px;
		padding: 1.25rem 1.5rem;
	}

	.project-heading {
		display: flex;
		align-items: baseline;
		gap: 1rem;
		flex-wrap: wrap;
	}

	.project-name {
		font-size: 1.05rem;
		font-weight: 600;
		text-decoration: none;
		color: var(--text);
	}

	.project-name:hover {
		color: var(--accent-strong);
	}

	.live-link {
		font-size: 0.82rem;
		font-weight: 600;
		text-decoration: none;
		color: var(--accent-strong);
	}

	.live-link:hover {
		color: var(--accent);
	}

	.project-description {
		margin: 0.5rem 0 0.85rem;
		color: var(--text-muted);
		font-size: 0.92rem;
		line-height: 1.55;
	}

	.tags {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
	}

	.tags li {
		font-size: 0.72rem;
		font-weight: 600;
		letter-spacing: 0.03em;
		color: var(--text-dim);
		background: var(--bg-raised);
		border: 1px solid var(--border);
		border-radius: 999px;
		padding: 0.2rem 0.6rem;
	}

	.tags li.muted {
		background: transparent;
		border-color: transparent;
		padding-left: 0;
		font-weight: 500;
	}
</style>
