		flex: 0 0 100%;
		display: block;
		aspect-ratio: 16 / 8;
		text-decoration: none;
		color: inherit;
	}

	.carousel-slide img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}

	.carousel-caption {
		position: absolute;
		left: 0;
		right: 0;
		bottom: 0;
		padding: 2.5rem 1.5rem 1rem;
		background: linear-gradient(180deg, transparent, rgba(0, 0, 0, 0.75));
		color: #fff;
		font-size: 1rem;
		font-weight: 600;
	}

	.carousel-nav {
		position: absolute;
		top: 50%;
		transform: translateY(-50%);
		display: flex;
		align-items: center;
		justify-content: center;
		width: 2.25rem;
		height: 2.25rem;
		border-radius: 50%;
		border: none;
		background: rgba(0, 0, 0, 0.45);
		color: #fff;
		cursor: pointer;
		transition: background 120ms ease;
	}

	.carousel-nav:hover {
		background: rgba(0, 0, 0, 0.65);
	}

	.carousel-prev {
		left: 0.75rem;
	}

	.carousel-next {
		right: 0.75rem;
	}

	.carousel-dots {
		position: absolute;
		bottom: 0.65rem;
		left: 50%;
		transform: translateX(-50%);
		display: flex;
		gap: 0.4rem;
	}

	.carousel-dot {
		width: 0.5rem;
		height: 0.5rem;
		border-radius: 50%;
		border: none;
		padding: 0;
		background: rgba(255, 255, 255, 0.5);
		cursor: pointer;
		transition: background 120ms ease, transform 120ms ease;
	}

	.carousel-dot.active {
		background: #fff;
		transform: scale(1.3);
	}

	.section-title {
		margin-top: 3rem;
		font-size: 0.78rem;
		font-weight: 600;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--text-dim);
	}

	.post-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 1.1rem;
	}

	.post-card {
		display: flex;
		gap: 1.1rem;
		border-bottom: 1px solid var(--border);
		padding-bottom: 1.1rem;
	}

	.post-thumb-link {
		flex: 0 0 auto;
	}

	.post-thumb {
		display: block;
		width: 100px;
		height: 72px;
		object-fit: cover;
		border-radius: 8px;
		border: 1px solid var(--border);
		background: var(--bg-raised);
	}

