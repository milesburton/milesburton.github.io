// A handful of articles are really landing pages for a topic (they mostly
// link out to other articles rather than being direct write-ups themselves).
// Flagged by hand -- a link-count heuristic misfires on articles that just
// happen to reference a few others inline.
const SECTION_SLUGS = new Set(['arduino', 'engineering', 'android_development', 'thoughts']);

const wikiFiles = import.meta.glob('./*.md', { eager: true, query: '?raw', import: 'default' }) as Record<string, string>;

function extractDate(raw: string): { iso: string; display: string } | null {
	const match = raw.match(/<time datetime="([^"]+)">([^<]+)<\/time>/);
	if (!match) return null;
	return { iso: match[1], display: match[2] };
}

function extractImage(raw: string): string | null {
	const match = raw.match(/!\[[^\]]*\]\((\/wiki-media\/[^)]+)\)/);
	return match?.[1] ?? null;
}

function extractDescription(raw: string): string | null {
	const body = raw.replace(/^---\n[\s\S]*?\n---\n/, '');
	const withoutHeading = body.replace(/^#\s+.+$/m, '');
	const withoutBadge = withoutHeading.replace(/<span class="wiki-section-badge">.*?<\/span>/s, '');
	const withoutDate = withoutBadge.replace(/<p class="wiki-date">.*?<\/p>/s, '');
	const withoutToc = withoutDate.replace(/## Contents[\s\S]*?(?=\n##[^#]|\n[A-Za-z]|$)/, '');
	const plain = withoutToc
		.replace(/<[^>]+>/g, ' ')
		.replace(/!\[[^\]]*\]\([^)]*\)/g, ' ')
		.replace(/\[([^\]]*)\]\([^)]*\)/g, '$1')
		.replace(/^#+\s.*$/gm, ' ')
		.replace(/[*_`]/g, '')
		.replace(/\s+/g, ' ')
		.trim();
	if (!plain) return null;
	const sentenceMatch = plain.match(/^.{0,180}?[.!?](?=\s|$)/);
	const snippet = sentenceMatch ? sentenceMatch[0] : plain.slice(0, 140).trim() + '…';
	return snippet.trim();
}

const dateBySlug = new Map<string, { iso: string; display: string }>();
const imageBySlug = new Map<string, string>();
const descriptionBySlug = new Map<string, string>();
for (const [path, raw] of Object.entries(wikiFiles)) {
	const slugMatch = path.match(/\.\/(.+)\.md$/);
	if (!slugMatch) continue;
	const slug = slugMatch[1];
	const date = extractDate(raw);
	if (date) dateBySlug.set(slug, date);
	const image = extractImage(raw);
	if (image) imageBySlug.set(slug, image);
	const description = extractDescription(raw);
	if (description) descriptionBySlug.set(slug, description);
}

