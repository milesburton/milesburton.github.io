---
import Layout from '../../layouts/Layout.astro';
import Carousel from '../../components/Carousel.astro';

// A handful of articles are really landing pages for a topic (they mostly
// link out to other articles rather than being direct write-ups themselves).
// Flagged by hand -- a link-count heuristic misfires on articles that just
// happen to reference a few others inline.
const SECTION_SLUGS = new Set(['arduino', 'engineering', 'android_development', 'thoughts']);

const wikiFiles = import.meta.glob('./*.md', { eager: true, query: '?raw', import: 'default' }) as Record<string, string>;

function extractDate(raw: string): { iso: string; display: string } | null {
	const match = raw.match(/<time datetime="([^"]+)">([^<]+)<\/time>/);
	if (!match) return null;
	return { iso: match[1], display: match[2] };
}

function extractImage(raw: string): string | null {
	const match = raw.match(/!\[[^\]]*\]\((\/wiki-media\/[^)]+)\)/);
	return match?.[1] ?? null;
}

function extractTitle(raw: string): string | null {
	const match = raw.match(/^title:\s*(.+)$/m);
	if (!match) return null;
	return match[1].trim().replace(/^"(.*)"$/, '$1');
}

function extractDescription(raw: string): string | null {
	const body = raw.replace(/^---\n[\s\S]*?\n---\n/, '');
	const withoutHeading = body.replace(/^#\s+.+$/m, '');
	const withoutBadge = withoutHeading.replace(/<span class="wiki-section-badge">.*?<\/span>/s, '');
	const withoutDate = withoutBadge.replace(/<p class="wiki-date">.*?<\/p>/s, '');
	const withoutToc = withoutDate.replace(/## Contents[\s\S]*?(?=\n##[^#]|\n[A-Za-z]|$)/, '');
	const plain = withoutToc
		.replace(/<[^>]+>/g, ' ')
		.replace(/!\[[^\]]*\]\([^)]*\)/g, ' ')
		.replace(/\[([^\]]*)\]\([^)]*\)/g, '$1')
		.replace(/^#+\s.*$/gm, ' ')
		.replace(/[*_`]/g, '')
		.replace(/\s+/g, ' ')
		.trim();
	if (!plain) return null;
	const sentenceMatch = plain.match(/^.{0,180}?[.!?](?=\s|$)/);
	const snippet = sentenceMatch ? sentenceMatch[0] : plain.slice(0, 140).trim() + '…';
	return snippet.trim();
}

const dateBySlug = new Map<string, { iso: string; display: string }>();
const imageBySlug = new Map<string, string>();
const descriptionBySlug = new Map<string, string>();
const titleBySlug = new Map<string, string>();
for (const [path, raw] of Object.entries(wikiFiles)) {
	const slugMatch = path.match(/\.\/(.+)\.md$/);
	if (!slugMatch) continue;
	const slug = slugMatch[1];
	if (slug === 'Main_Page') continue;
	const title = extractTitle(raw);
	if (title) titleBySlug.set(slug, title);
	const date = extractDate(raw);
	if (date) dateBySlug.set(slug, date);
	const image = extractImage(raw);
	if (image) imageBySlug.set(slug, image);
	const description = extractDescription(raw);
	if (description) descriptionBySlug.set(slug, description);
}

const featured = [
	{
		image: '/wiki-media/ArduinoAWD_Loaded.JPG',
		alt: 'Arduino-powered all-wheel-drive robot with an ultrasonic sensor mounted on a pan/tilt bracket',
		title: 'Arduino All-Wheel-Drive (A4WD) Robot Trials',
		href: '/wiki/arduino_all_wheel_drive_a4wd_robot_trials/',
	},
	{
		image: '/wiki-media/Phoenix_Build_-_Completed_Build_iso_shot.jpeg',
		alt: 'Completed 2023 development machine build in a tempered-glass PC case',
		title: '2023 Development Machine Build',
		href: '/wiki/2023_development_machine_build/',
	},
	{
		image: '/wiki-media/2E0ERI_27-06-2016.jpg',
		alt: 'Handing over an amateur radio licence certificate at a radio club',
		title: 'M0LHA',
		href: '/wiki/m0lha/',
	},
	{
		image: '/wiki-media/D257_TOP.JPG',
		alt: 'Acer Aspire One D257 netbook opened up for a RAM and hard disk upgrade',
		title: 'Acer Aspire One D257 Ram Upgrade - Pictures',
		href: '/wiki/acer_aspire_one_d257_ram_upgrade_pictures/',
	},
	{
		image: '/wiki-media/TCL_Breakout1.JPG',
		alt: 'Hand-soldered breakout board with resistors on stripboard',
		title: 'Dallas Temperature Control Library',
		href: '/wiki/dallas_temperature_control_library/',
	},
	{
		image: '/wiki-media/ArduinoWirelessLCD_Prototype1.jpg',
		alt: 'Prototype wireless LCD shield built on a breadboard',
		title: 'LCD Shield Goes Wireless 433Mhz',
		href: '/wiki/lcd_shield_goes_wireless_433mhz/',
	},
];

const carouselSlides = featured.map((item) => ({
	href: item.href,
	image: item.image,
	alt: item.alt,
	caption: item.title,
}));

const articles = Array.from(titleBySlug.entries()).map(([slug, title]) => ({
	title,
	href: `/wiki/${slug}/`,
	date: dateBySlug.get(slug),
	image: imageBySlug.get(slug),
	description: descriptionBySlug.get(slug),
	isSection: SECTION_SLUGS.has(slug),
}));

articles.sort((a, b) => {
	if (!a.date && !b.date) return a.title.localeCompare(b.title);
	if (!a.date) return 1;
	if (!b.date) return -1;
	return new Date(b.date.iso).valueOf() - new Date(a.date.iso).valueOf();
});
---

<Layout title="Wiki" description="Miles Burton's personal wiki: organic thoughts, guides, and general write-ups.">
	<main class="shell">
		<h1>Wiki</h1>
		<p class="intro">
			This is where I keep organic thoughts, guides, and general write-ups. Some of it is old, some of it is
			niche, but feel free to have a look around.
		</p>

		<Carousel id="wiki-carousel" slides={carouselSlides} spacing="above" />

		<h2 class="section-title">Articles</h2>
		<ul class="post-list">
			{articles.map((article) => (
				<li class="post-card">
					<a href={article.href} class="post-thumb-link" tabindex="-1" aria-hidden="true">
						{article.image ? (
							<img src={article.image} alt="" class="post-thumb" loading="lazy" />
						) : (
							<span class="post-thumb post-thumb-placeholder">
								<svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
									<rect x="3" y="3" width="18" height="18" rx="2" fill="none" stroke="currentColor" stroke-width="1.5" />
									<circle cx="8.5" cy="8.5" r="1.5" fill="currentColor" />
									<path d="M21 15l-5-5-9 9" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
								</svg>
							</span>
						)}
					</a>
					<div class="post-body">
						<div class="post-title-row">
							<a href={article.href} class="post-title">
								{article.title}
							</a>
							{article.isSection && <span class="section-badge">Section</span>}
						</div>
						{article.date && <time datetime={article.date.iso}>{article.date.display}</time>}
						{article.description && <p class="post-excerpt">{article.description}</p>}
					</div>
				</li>
			))}
		</ul>
	</main>
</Layout>

<style>
	main.shell {
		--shell-max-width: 900px;
	}

	h1 {
		font-size: clamp(1.9rem, 4vw, 2.6rem);
		margin: 0;
	}

	.intro {
		margin-top: 0.85rem;
		max-width: 65ch;
		color: var(--text-muted);
		line-height: 1.6;
	}

	.section-title {
		margin-top: 3rem;
		font-size: 0.78rem;
		font-weight: 600;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--text-dim);
	}

	.post-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 1.1rem;
	}

	.post-card {
		display: flex;
		gap: 1.1rem;
		border-bottom: 1px solid var(--border);
		padding-bottom: 1.1rem;
	}

	.post-thumb-link {
		flex: 0 0 auto;
	}

	.post-thumb {
		display: block;
		width: 100px;
		height: 72px;
		object-fit: cover;
		border-radius: 8px;
		border: 1px solid var(--border);
		background: var(--bg-raised);
	}

	.post-thumb-placeholder {
		display: flex;
		align-items: center;
		justify-content: center;
		color: var(--text-dim);
		border-style: dashed;
	}

	.post-body {
		flex: 1;
		min-width: 0;
	}

	.post-title-row {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 0.5rem;
	}

	.post-title {
		display: block;
		font-size: 1.05rem;
		font-weight: 600;
		text-decoration: none;
		color: var(--text);
		line-height: 1.4;
	}

	.post-title:hover {
		color: var(--accent-strong);
	}

	.section-badge {
		font-size: 0.66rem;
		font-weight: 700;
		letter-spacing: 0.05em;
		text-transform: uppercase;
		color: var(--accent-strong);
		background: var(--nav-active-bg);
		border-radius: 999px;
		padding: 0.15rem 0.55rem;
	}

	.post-card time {
		display: block;
		margin-top: 0.3rem;
		font-size: 0.78rem;
		color: var(--text-dim);
	}

	.post-excerpt {
		margin: 0.5rem 0 0;
		color: var(--text-muted);
		font-size: 0.92rem;
		line-height: 1.55;
	}

	@media (max-width: 560px) {
		.post-thumb {
			width: 72px;
			height: 72px;
		}
	}
</style>
