---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';

const links = [
	{ label: 'GitHub', value: 'github.com/milesburton', href: 'https://github.com/milesburton' },
	{ label: 'LinkedIn', value: 'linkedin.com/in/milesburton', href: 'https://www.linkedin.com/in/milesburton/' },
	{ label: 'Callsign', value: 'M0LHA', href: 'https://www.qrz.com/db/M0LHA' },
];

// Split so the address never appears intact in the page source or JS bundle —
// reassembled client-side on load, which defeats the vast majority of email
// harvesters (they scan static HTML/JS text, not executed DOM output).
const emailUser = 'miles.burton';
const emailDomain = 'gmail.com';
---

<Layout title="Contact" description="Get in touch with Miles Burton.">
	<main class="shell">
		<PageHeader kicker="Contact" title="Get in touch">
			<Fragment slot="intro">
				Happy to hear from you about engineering work, collaboration, or anything on this site.
			</Fragment>
		</PageHeader>

		<ul class="link-list">
			<li>
				<span class="label">Email</span>
				<a id="email-link" href="#" data-user={emailUser} data-domain={emailDomain} rel="nofollow">
					<noscript>Enable JavaScript to view, or reach me on GitHub/LinkedIn instead</noscript>
				</a>
			</li>
			{links.map((link) => (
				<li>
					<span class="label">{link.label}</span>
					<a href={link.href} target="_blank" rel="noreferrer">{link.value}</a>
				</li>
			))}
		</ul>
	</main>
</Layout>

<script>
	const link = document.getElementById('email-link');
	if (link) {
		const address = `${link.dataset.user}@${link.dataset.domain}`;
		link.href = `mailto:${address}`;
		link.textContent = address;
	}
</script>

<style>
	main.shell {
		--shell-max-width: 720px;
	}

	.link-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
	}

	.link-list li {
		display: flex;
		align-items: baseline;
		gap: 0.75rem;
		background: var(--bg-card);
		border: 1px solid var(--border);
		border-radius: 10px;
		padding: 1rem 1.25rem;
	}

	.label {
		flex: 0 0 90px;
		font-size: 0.78rem;
		font-weight: 600;
		letter-spacing: 0.05em;
		text-transform: uppercase;
		color: var(--text-dim);
	}

	.link-list a {
		color: var(--text);
		text-decoration: none;
		font-size: 0.95rem;
	}

	.link-list a:hover {
		color: var(--accent-strong);
	}
</style>
