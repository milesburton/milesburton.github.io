---
import Layout from '../../layouts/Layout.astro';

const links = [
	{ label: 'Email', value: 'miles.burton@gmail.com', href: 'mailto:miles.burton@gmail.com' },
	{ label: 'GitHub', value: 'github.com/milesburton', href: 'https://github.com/milesburton' },
	{ label: 'LinkedIn', value: 'linkedin.com/in/milesburton', href: 'https://www.linkedin.com/in/milesburton/' },
];
---

<Layout title="Contact" description="Get in touch with Miles Burton.">
	<main class="shell">
		<header class="page-header">
			<p class="kicker">Contact</p>
			<h1>Get in touch</h1>
			<p class="intro">
				Happy to hear from you about engineering work, collaboration, or anything on this site.
			</p>
		</header>

		<ul class="link-list">
			{links.map((link) => (
				<li>
					<span class="label">{link.label}</span>
					<a href={link.href} target="_blank" rel="noreferrer">{link.value}</a>
				</li>
			))}
		</ul>
	</main>
</Layout>

<style>
	.shell {
		max-width: 720px;
		margin: 0 auto;
		padding: 4rem 2rem 5rem;
	}

	.page-header {
		margin-bottom: 2.5rem;
	}

	.kicker {
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--accent-strong);
		font-size: 0.78rem;
		font-weight: 600;
		margin: 0 0 0.75rem;
	}

	h1 {
		font-size: clamp(1.9rem, 4vw, 2.6rem);
		margin: 0;
	}

	.intro {
		margin-top: 0.85rem;
		max-width: 60ch;
		color: var(--text-muted);
		line-height: 1.6;
	}

	.link-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
	}

	.link-list li {
		display: flex;
		align-items: baseline;
		gap: 0.75rem;
		background: var(--bg-card);
		border: 1px solid var(--border);
		border-radius: 10px;
		padding: 1rem 1.25rem;
	}

	.label {
		flex: 0 0 90px;
		font-size: 0.78rem;
		font-weight: 600;
		letter-spacing: 0.05em;
		text-transform: uppercase;
		color: var(--text-dim);
	}

	.link-list a {
		color: var(--text);
		text-decoration: none;
		font-size: 0.95rem;
	}

	.link-list a:hover {
		color: var(--accent-strong);
	}
</style>
