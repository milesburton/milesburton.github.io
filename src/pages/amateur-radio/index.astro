---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import SocialIcon from '../../components/SocialIcon.astro';
import Carousel from '../../components/Carousel.astro';
import PostCard from '../../components/PostCard.astro';
import { getCollection } from 'astro:content';
import { formatDate } from '../../lib/format';
import { getHeroImage } from '../../lib/posts';

const allPosts = await getCollection('blog');
const posts = allPosts
	.filter((post) => post.data.categories?.includes('Amateur Radio'))
	.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const carouselSlides = [
	{
		href: '/wiki/m0lha/',
		image: '/wiki-media/2E0ERI_27-06-2016.jpg',
		alt: 'Handing over an amateur radio licence certificate at a radio club',
		caption: 'M0LHA: from Foundation to Advanced',
	},
	{
		href: '/wiki/m0lha/',
		image: '/wiki-media/Martin-Miles.jpg',
		alt: 'Two amateur radio operators at a club meeting',
		caption: 'Thurrock Acorns Radio Club',
	},
	{
		href: '/wiki/m0lha/',
		image: '/wiki-media/20160427_190156.jpg',
		alt: 'Amateur radio licence documentation and study materials',
		caption: 'Licence progression',
	},
	{
		href: '/wiki/m0lha/',
		image: '/wiki-media/20170506_115826.jpg',
		alt: 'Amateur radio equipment and station setup',
		caption: 'Station setup',
	},
];
---

<Layout title="Amateur Radio" description="Miles Burton's amateur radio callsign, licence progression, and writing on the hobby.">
	<main class="shell">
		<PageHeader kicker="Hobby" title="Amateur Radio">
			<Fragment slot="intro">
				Licensed as <strong>M0LHA</strong>. Notes on getting licensed, the gear, and tinkering with radios,
				antennas, and packet software along the way.
			</Fragment>
			<div class="header-links">
				<a href="https://www.qrz.com/db/M0LHA" target="_blank" rel="noreferrer" class="callsign-link">
					View callsign on QRZ
					<SocialIcon name="external-link" size={12} class="external-icon" />
				</a>
				<a href="/wiki/m0lha/" class="callsign-link">
					M0LHA wiki notes
					<span class="section-badge">Section</span>
				</a>
			</div>
		</PageHeader>

		<Carousel id="amateur-radio-carousel" slides={carouselSlides} />

		<ul class="post-list">
			{posts.map((post) => (
				<PostCard href={`/blog/${post.data.slug}/`} image={getHeroImage(post)} title={post.data.title}>
					<Fragment slot="meta">
						<time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
					</Fragment>
					{post.data.excerpt && <p class="post-excerpt" slot="excerpt">{post.data.excerpt}</p>}
				</PostCard>
			))}
		</ul>
	</main>
</Layout>

<style>
	.header-links {
		display: flex;
		flex-wrap: wrap;
		gap: 1.25rem;
		margin-top: 1.1rem;
	}

	.callsign-link {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		color: var(--accent-strong);
		font-size: 0.88rem;
		font-weight: 600;
		text-decoration: none;
	}

	.callsign-link:hover {
		color: var(--accent);
	}

	.external-icon {
		flex: 0 0 auto;
		opacity: 0.7;
	}

	.section-badge {
		font-size: 0.66rem;
		font-weight: 700;
		letter-spacing: 0.05em;
		text-transform: uppercase;
		color: var(--accent-strong);
		background: var(--nav-active-bg);
		border-radius: 999px;
		padding: 0.15rem 0.55rem;
	}

	time {
		display: block;
		margin-top: 0.3rem;
		font-size: 0.78rem;
		color: var(--text-dim);
	}

	.post-excerpt {
		margin: 0.5rem 0 0;
		color: var(--text-muted);
		font-size: 0.92rem;
		line-height: 1.55;
	}
</style>
