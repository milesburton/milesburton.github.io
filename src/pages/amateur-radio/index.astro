---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog');
const posts = allPosts
	.filter((post) => post.data.categories?.includes('Amateur Radio'))
	.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const formatter = new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
---

<Layout title="Amateur Radio" description="Miles Burton's amateur radio callsign, licence progression, and writing on the hobby.">
	<main class="shell">
		<header class="page-header">
			<p class="kicker">Hobby</p>
			<h1>Amateur Radio</h1>
			<p class="intro">
				Licensed as <strong>M0LHA</strong>. Notes on getting licensed, the gear, and tinkering with radios,
				antennas, and packet software along the way.
			</p>
			<a href="https://www.qrz.com/db/M0LHA" target="_blank" rel="noreferrer" class="callsign-link">
				View callsign on QRZ
				<svg class="external-icon" viewBox="0 0 24 24" width="12" height="12" aria-hidden="true">
					<path
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
						stroke-linejoin="round"
						d="M7 17L17 7M9 7h8v8"
					/>
				</svg>
			</a>
		</header>

		<ul class="post-list">
			{posts.map((post) => (
				<li class="post-card">
					<a href={`/blog/${post.data.slug}/`} class="post-title">
						{post.data.title}
					</a>
					<time datetime={post.data.date.toISOString()}>{formatter.format(post.data.date)}</time>
					{post.data.excerpt && <p class="post-excerpt">{post.data.excerpt}</p>}
				</li>
			))}
		</ul>
	</main>
</Layout>

<style>
	.shell {
		max-width: 780px;
		margin: 0 auto;
		padding: 4rem 2rem 5rem;
	}

	.page-header {
		margin-bottom: 2.5rem;
	}

	.kicker {
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--accent-strong);
		font-size: 0.78rem;
		font-weight: 600;
		margin: 0 0 0.75rem;
	}

	h1 {
		font-size: clamp(1.9rem, 4vw, 2.6rem);
		margin: 0;
	}

	.intro {
		margin-top: 0.85rem;
		max-width: 60ch;
		color: var(--text-muted);
		line-height: 1.6;
	}

	.callsign-link {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		margin-top: 1.1rem;
		color: var(--accent-strong);
		font-size: 0.88rem;
		font-weight: 600;
		text-decoration: none;
	}

	.callsign-link:hover {
		color: var(--accent);
	}

	.external-icon {
		flex: 0 0 auto;
		opacity: 0.7;
	}

	.post-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 1.1rem;
	}

	.post-card {
		border-bottom: 1px solid var(--border);
		padding-bottom: 1.1rem;
	}

	.post-title {
		display: block;
		font-size: 1.05rem;
		font-weight: 600;
		text-decoration: none;
		color: var(--text);
		line-height: 1.4;
	}

	.post-title:hover {
		color: var(--accent-strong);
	}

	time {
		display: block;
		margin-top: 0.3rem;
		font-size: 0.78rem;
		color: var(--text-dim);
	}

	.post-excerpt {
		margin: 0.5rem 0 0;
		color: var(--text-muted);
		font-size: 0.92rem;
		line-height: 1.55;
	}
</style>
