---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import SocialIcon from '../../components/SocialIcon.astro';
import { getCollection } from 'astro:content';
import { formatDate } from '../../lib/format';

const allPosts = await getCollection('blog');
const posts = allPosts
	.filter((post) => post.data.categories?.includes('Amateur Radio'))
	.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Layout title="Amateur Radio" description="Miles Burton's amateur radio callsign, licence progression, and writing on the hobby.">
	<main class="shell">
		<PageHeader kicker="Hobby" title="Amateur Radio">
			<Fragment slot="intro">
				Licensed as <strong>M0LHA</strong>. Notes on getting licensed, the gear, and tinkering with radios,
				antennas, and packet software along the way.
			</Fragment>
			<div class="header-links">
				<a href="https://www.qrz.com/db/M0LHA" target="_blank" rel="noreferrer" class="callsign-link">
					View callsign on QRZ
					<SocialIcon name="external-link" size={12} class="external-icon" />
				</a>
				<a href="/wiki/m0lha/" class="callsign-link">
					M0LHA wiki notes
				</a>
			</div>
		</PageHeader>

		<ul class="post-list">
			{posts.map((post) => (
				<li class="post-card">
					<a href={`/blog/${post.data.slug}/`} class="post-title">
						{post.data.title}
					</a>
					<time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
					{post.data.excerpt && <p class="post-excerpt">{post.data.excerpt}</p>}
				</li>
			))}
		</ul>
	</main>
</Layout>

<style>
	.header-links {
		display: flex;
		flex-wrap: wrap;
		gap: 1.25rem;
		margin-top: 1.1rem;
	}

	.callsign-link {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		color: var(--accent-strong);
		font-size: 0.88rem;
		font-weight: 600;
		text-decoration: none;
	}

	.callsign-link:hover {
		color: var(--accent);
	}

	.external-icon {
		flex: 0 0 auto;
		opacity: 0.7;
	}

	.post-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 1.1rem;
	}

	.post-card {
		border-bottom: 1px solid var(--border);
		padding-bottom: 1.1rem;
	}

	.post-title {
		display: block;
		font-size: 1.05rem;
		font-weight: 600;
		text-decoration: none;
		color: var(--text);
		line-height: 1.4;
	}

	.post-title:hover {
		color: var(--accent-strong);
	}

	time {
		display: block;
		margin-top: 0.3rem;
		font-size: 0.78rem;
		color: var(--text-dim);
	}

	.post-excerpt {
		margin: 0.5rem 0 0;
		color: var(--text-muted);
		font-size: 0.92rem;
		line-height: 1.55;
	}
</style>
