---
import Layout from '../layouts/Layout.astro';
---

<Layout>
	<main class="shell">
		<header class="hero">
			<p class="kicker">milesburton.com</p>
			<h1>Miles Burton</h1>
			<p class="intro">
				Engineering, trading systems, automation, and open-source projects.
			</p>
		</header>

		<section class="cards" aria-label="Primary destinations">
			<a class="card" href="https://github.com/milesburton" target="_blank" rel="noopener noreferrer">
				<h2>GitHub</h2>
				<p>Code, repositories, and active projects.</p>
			</a>
			<a class="card" href="https://www.linkedin.com" target="_blank" rel="noopener noreferrer">
				<h2>LinkedIn</h2>
				<p>Professional profile and background.</p>
			</a>
			<a class="card" href="https://x.com" target="_blank" rel="noopener noreferrer">
				<h2>Updates</h2>
				<p>Short-form updates and announcements.</p>
			</a>
			<a class="card" href="mailto:hello@milesburton.com">
				<h2>Contact</h2>
				<p>Direct email for collaborations and enquiries.</p>
			</a>
		</section>
	</main>
</Layout>

<style>
	.shell {
		max-width: 1050px;
		margin: 0 auto;
		padding: 3.5rem 1.25rem 4rem;
	}

	.hero {
		margin-bottom: 2.2rem;
	}

	.kicker {
		letter-spacing: 0.11em;
		text-transform: uppercase;
		color: #93c5fd;
		font-size: 0.8rem;
		margin-bottom: 0.6rem;
	}

	h1 {
		font-size: clamp(2rem, 5.5vw, 4.2rem);
		margin: 0;
		line-height: 1.03;
	}

	.intro {
		margin-top: 0.9rem;
		max-width: 62ch;
		color: #cbd5e1;
		font-size: clamp(1rem, 2.2vw, 1.24rem);
	}

	.cards {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
		gap: 1rem;
	}

	.card {
		background: linear-gradient(180deg, rgba(15, 23, 42, 0.9), rgba(15, 23, 42, 0.65));
		border: 1px solid rgba(148, 163, 184, 0.32);
		border-radius: 14px;
		padding: 1rem 1rem 1.2rem;
		color: inherit;
		text-decoration: none;
		transition: transform 130ms ease, border-color 130ms ease, box-shadow 130ms ease;
	}

	.card:hover {
		transform: translateY(-3px);
		border-color: rgba(125, 211, 252, 0.65);
		box-shadow: 0 12px 24px rgba(2, 6, 23, 0.28);
	}

	.card h2 {
		margin: 0 0 0.5rem;
		font-size: 1.08rem;
		color: #e2e8f0;
	}

	.card p {
		margin: 0;
		color: #cbd5e1;
		line-height: 1.45;
	}
</style>
