---
import Layout from '../layouts/Layout.astro';

const tiles = [
	{
		href: '/projects/',
		kicker: 'Engineering',
		title: 'Projects',
		description: 'Open-source libraries and systems I maintain — from embedded sensor libraries used worldwide to a paper-trading platform for market simulation.',
	},
	{
		href: '/blog/',
		kicker: 'Writing',
		title: 'Blog',
		description: 'Notes on infrastructure, embedded electronics, and networking — home lab builds, self-hosting, and the occasional deep dive.',
	},
	{
		href: '/wiki/Main_Page/',
		kicker: 'Reference',
		title: 'Wiki & Notes',
		description: 'A long-running personal knowledge base of guides and reference material, now consolidated into this site.',
	},
	{
		href: '/contact/',
		kicker: 'Contact',
		title: 'Get in touch',
		description: 'Reach out about engineering work, collaboration, or anything you’ve read here.',
	},
];
---

<Layout>
	<main class="shell">
		<header class="hero">
			<p class="kicker">Software Engineer</p>
			<h1>Miles Burton</h1>
			<p class="intro">
				I build trading systems, infrastructure, and embedded software. This site collects my
				projects, writing, and reference notes in one place.
			</p>
		</header>

		<section class="tiles">
			{tiles.map((tile) => (
				<a href={tile.href} class="tile">
					<p class="tile-kicker">{tile.kicker}</p>
					<h2>{tile.title}</h2>
					<p class="tile-description">{tile.description}</p>
					<span class="tile-arrow" aria-hidden="true">&rarr;</span>
				</a>
			))}
		</section>
	</main>
</Layout>

<style>
	.shell {
		max-width: 920px;
		margin: 0 auto;
		padding: 4rem 2rem 5rem;
	}

	.hero {
		margin-bottom: 3rem;
	}

	.kicker {
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--accent-strong);
		font-size: 0.78rem;
		font-weight: 600;
		margin: 0 0 0.75rem;
	}

	h1 {
		font-size: clamp(2.25rem, 5vw, 3.4rem);
		margin: 0;
		line-height: 1.05;
		letter-spacing: -0.01em;
	}

	.intro {
		margin-top: 1rem;
		max-width: 58ch;
		color: var(--text-muted);
		font-size: 1.08rem;
		line-height: 1.6;
	}

	.tiles {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 1rem;
	}

	.tile {
		position: relative;
		display: block;
		background: var(--bg-card);
		border: 1px solid var(--border);
		border-radius: 12px;
		padding: 1.5rem 1.5rem 1.75rem;
		text-decoration: none;
		color: inherit;
		transition: transform 130ms ease, border-color 130ms ease, background 130ms ease;
	}

	.tile:hover {
		transform: translateY(-2px);
		border-color: var(--border-strong);
		background: var(--bg-raised);
	}

	.tile-kicker {
		font-size: 0.72rem;
		font-weight: 600;
		letter-spacing: 0.09em;
		text-transform: uppercase;
		color: var(--text-dim);
		margin: 0 0 0.5rem;
	}

	.tile h2 {
		margin: 0 0 0.5rem;
		font-size: 1.2rem;
		color: var(--text);
	}

	.tile-description {
		margin: 0;
		color: var(--text-muted);
		font-size: 0.92rem;
		line-height: 1.55;
	}

	.tile-arrow {
		position: absolute;
		top: 1.5rem;
		right: 1.5rem;
		color: var(--text-dim);
		transition: transform 130ms ease, color 130ms ease;
	}

	.tile:hover .tile-arrow {
		transform: translateX(3px);
		color: var(--accent-strong);
	}

	@media (max-width: 620px) {
		.tiles {
			grid-template-columns: 1fr;
		}

		.shell {
			padding: 2.5rem 1.25rem 3rem;
		}
	}
</style>
