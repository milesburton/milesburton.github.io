---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog');

function heroImage(post: (typeof allPosts)[number]): string | undefined {
	if (post.data.featuredImage) return post.data.featuredImage;
	const match = post.body?.match(/<img[^>]+src="(\/blog-media\/[^"]+)"/);
	return match?.[1];
}

const latestPosts = allPosts
	.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
	.slice(0, 3)
	.map((post) => {
		const wordCount = (post.body ?? '').replace(/<[^>]+>/g, ' ').trim().split(/\s+/).filter(Boolean).length;
		const readingMinutes = Math.max(1, Math.round(wordCount / 200));
		return {
			href: `/blog/${post.data.slug}/`,
			title: post.data.title,
			date: post.data.date,
			excerpt: post.data.excerpt,
			category: post.data.tags[0],
			readingMinutes,
			image: heroImage(post),
		};
	});

const dateFormatter = new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });

const featured = [
	{
		href: 'https://github.com/milesburton/Arduino-Temperature-Control-Library',
		external: true,
		image: '/images/projects/arduino-dashboard.jpg',
		imageAlt: 'Live sensor data dashboard showing a temperature graph over time',
		kicker: 'Open Source · 1k+ stars',
		title: 'Arduino Temperature Control Library',
		description: 'The de-facto Arduino/ESP32 library for Maxim/Dallas 1-Wire temperature sensors (DS18B20 and family). Widely used across the embedded hobbyist and IoT ecosystem.',
		tags: ['C++', 'Embedded', '1-Wire'],
	},
	{
		href: 'https://github.com/milesburton/veta-trading-platform',
		external: true,
		liveHref: 'https://veta.mnetcs.com/',
		image: '/images/projects/veta-dashboard.jpg',
		imageAlt: 'VETA trading terminal showing a live market ladder, orders, and positions panels',
		kicker: 'Finance · In progress',
		title: 'VETA Trading Platform',
		description: 'A near-real-world trading platform for paper-trading algorithmic strategies against simulated and real market data, built to help people learn market dynamics without risking capital.',
		tags: ['TypeScript', 'Trading', 'WIP'],
	},
	{
		href: 'https://github.com/milesburton/teslacam',
		external: true,
		image: '/images/projects/teslacam.jpg',
		imageAlt: 'Tesla center console showing dash-cam footage on screen with a laptop running the TeslaCam software',
		kicker: 'Open Source · 100+ stars',
		title: 'TeslaCam',
		description: 'Automates backup, cloud storage, and remote access for Tesla dash-cam footage using a Raspberry Pi Zero W.',
		tags: ['JavaScript', 'Raspberry Pi', 'Automation'],
	},
];

const videos = [
	{
		id: 'iIxMoZ9kPPo',
		kicker: 'Building Systems · Radio',
		title: 'Baofeng UV-5R receiving SSTV image with android phone',
	},
	{
		id: 'pMbwPwEmuzA',
		kicker: 'Building Systems · Hardware',
		title: 'Upgrading the Lenovo ThinkCentre M80q Gen 3',
	},
	{
		id: 'Swy85Oqn3RY',
		kicker: 'Running Infrastructure',
		title: 'Jonsbo N3 Ryzen ITX NAS build',
	},
];

const topics = [
	{ href: '/topics/ai/', title: 'AI & Local Compute' },
	{ href: '/topics/radio/', title: 'Amateur Radio & Mesh' },
	{ href: '/topics/homelab/', title: 'Homelab & Infrastructure' },
	{ href: '/topics/embedded/', title: 'Embedded & Electronics' },
	{ href: '/topics/software/', title: 'Software Engineering' },
	{ href: '/topics/energy/', title: 'Energy & EVs' },
];

const more = [
	{
		href: '/projects/',
		kicker: 'Engineering',
		title: 'All Projects',
		description: 'The rest of the open-source libraries and systems I maintain.',
	},
	{
		href: '/blog/',
		kicker: 'Writing',
		title: 'Writing',
		description: 'Notes on infrastructure, embedded electronics, and networking.',
	},
	{
		href: '/wiki/Main_Page/',
		kicker: 'Reference',
		title: 'Notes',
		description: 'A long-running personal knowledge base, being consolidated here.',
	},
	{
		href: '/contact/',
		kicker: 'Contact',
		title: 'Get in touch',
		description: 'Reach out about engineering work, collaboration, or anything here.',
	},
];
---

<Layout>
	<main class="shell">
		<header class="hero">
			<p class="kicker">Software Engineer</p>
			<h1>Miles Burton</h1>
			<p class="intro">
				Engineer building systems across software, radio, AI and embedded hardware.
			</p>
			<p class="intro">
				Open-source projects, practical experiments and observations from more than two decades of
				building and breaking technology.
			</p>
			<nav class="profile-strip" aria-label="Profile links">
				<a href="https://www.linkedin.com/in/milesburton/" target="_blank" rel="noreferrer">
					<svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true">
						<path
							fill="currentColor"
							d="M20.45 20.45h-3.56v-5.57c0-1.33-.03-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.34V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.38-1.85 3.61 0 4.28 2.38 4.28 5.47v6.27zM5.34 7.43a2.07 2.07 0 1 1 0-4.13 2.07 2.07 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56v11.45z"
						/>
					</svg>
					LinkedIn
				</a>
				<a href="https://github.com/milesburton" target="_blank" rel="noreferrer">
					<svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true">
						<path
							fill="currentColor"
							d="M12 .5C5.73.5.5 5.73.5 12c0 5.09 3.29 9.4 7.86 10.93.58.1.79-.25.79-.56 0-.27-.01-1.17-.02-2.12-3.2.7-3.88-1.36-3.88-1.36-.52-1.33-1.28-1.68-1.28-1.68-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.03 1.75 2.7 1.25 3.36.96.1-.75.4-1.25.73-1.53-2.55-.29-5.24-1.28-5.24-5.68 0-1.25.45-2.28 1.18-3.08-.12-.29-.51-1.46.11-3.04 0 0 .96-.31 3.15 1.18a10.9 10.9 0 0 1 5.74 0c2.19-1.49 3.15-1.18 3.15-1.18.62 1.58.23 2.75.11 3.04.73.8 1.18 1.83 1.18 3.08 0 4.41-2.69 5.38-5.25 5.67.41.36.78 1.07.78 2.15 0 1.55-.01 2.8-.01 3.18 0 .31.21.67.8.56A10.52 10.52 0 0 0 23.5 12C23.5 5.73 18.27.5 12 .5z"
						/>
					</svg>
					GitHub
				</a>
				<a href="https://www.youtube.com/@M0LHA" target="_blank" rel="noreferrer">
					<svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true">
						<path
							fill="currentColor"
							d="M23.5 6.19a3.02 3.02 0 0 0-2.12-2.14C19.5 3.5 12 3.5 12 3.5s-7.5 0-9.38.55A3.02 3.02 0 0 0 .5 6.19 31.6 31.6 0 0 0 0 12a31.6 31.6 0 0 0 .5 5.81 3.02 3.02 0 0 0 2.12 2.14c1.88.55 9.38.55 9.38.55s7.5 0 9.38-.55a3.02 3.02 0 0 0 2.12-2.14A31.6 31.6 0 0 0 24 12a31.6 31.6 0 0 0-.5-5.81zM9.55 15.57V8.43L15.82 12l-6.27 3.57z"
						/>
					</svg>
					YouTube
				</a>
				<a href="/contact/">
					<svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true">
						<path
							fill="none"
							stroke="currentColor"
							stroke-width="1.6"
							stroke-linecap="round"
							stroke-linejoin="round"
							d="M3 6.5A1.5 1.5 0 0 1 4.5 5h15A1.5 1.5 0 0 1 21 6.5v11a1.5 1.5 0 0 1-1.5 1.5h-15A1.5 1.5 0 0 1 3 17.5v-11z M3.5 6.5l8.5 6 8.5-6"
						/>
					</svg>
					Contact
				</a>
			</nav>
		</header>

		<section class="featured">
			<h2 class="section-title">Featured Projects</h2>
			<div class="featured-grid">
				{featured.map((project) => (
					<div class="featured-card">
						<img src={project.image} alt={project.imageAlt} class="featured-image" loading="lazy" />
						<p class="featured-kicker">{project.kicker}</p>
						<h3>{project.title}</h3>
						<p class="featured-description">{project.description}</p>
						<ul class="tags">
							{project.tags.map((tag) => (
								<li>{tag}</li>
							))}
						</ul>
						<div class="featured-links">
							<a href={project.href} target={project.external ? '_blank' : undefined} rel={project.external ? 'noreferrer' : undefined} class={project.external ? 'external' : undefined}>
								GitHub
								{project.external && (
									<svg class="external-icon" viewBox="0 0 24 24" width="12" height="12" aria-hidden="true">
										<path
											fill="none"
											stroke="currentColor"
											stroke-width="2"
											stroke-linecap="round"
											stroke-linejoin="round"
											d="M7 17L17 7M9 7h8v8"
										/>
									</svg>
								)}
							</a>
							{project.liveHref && (
								<a href={project.liveHref} target="_blank" rel="noreferrer" class="featured-live-link">
									Live site &rarr;
								</a>
							)}
						</div>
					</div>
				))}
			</div>
		</section>

		<section class="latest">
			<h2 class="section-title">Selected Writing</h2>
			<ul class="latest-list">
				{latestPosts.map((post) => (
					<li class="latest-card">
						<a href={post.href} class="latest-thumb-link" tabindex="-1" aria-hidden="true">
							{post.image ? (
								<img src={post.image} alt="" class="latest-thumb" loading="lazy" />
							) : (
								<span class="latest-thumb latest-thumb-placeholder">
									<svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
										<rect x="3" y="3" width="18" height="18" rx="2" fill="none" stroke="currentColor" stroke-width="1.5" />
										<circle cx="8.5" cy="8.5" r="1.5" fill="currentColor" />
										<path d="M21 15l-5-5-9 9" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
									</svg>
								</span>
							)}
						</a>
						<div class="latest-body">
							<a href={post.href} class="latest-title">
								{post.title}
							</a>
							<div class="latest-meta">
								<time datetime={post.date.toISOString()}>{dateFormatter.format(post.date)}</time>
								{post.category && (
									<>
										<span class="latest-sep">·</span>
										<span class="latest-category">{post.category}</span>
									</>
								)}
								<span class="latest-sep">·</span>
								<span>{post.readingMinutes} min read</span>
							</div>
							{post.excerpt && <p class="latest-excerpt">{post.excerpt}</p>}
						</div>
					</li>
				))}
			</ul>
		</section>

		<section class="videos">
			<h2 class="section-title">Selected Videos</h2>
			<div class="video-grid">
				{videos.map((video) => (
					<div class="video-card">
						<button
							type="button"
							class="video-thumb"
							data-video-id={video.id}
							aria-label={`Play video: ${video.title}`}
						>
							<img src={`https://i.ytimg.com/vi/${video.id}/hqdefault.jpg`} alt="" loading="lazy" />
							<span class="play-icon" aria-hidden="true">
								<svg viewBox="0 0 24 24" width="20" height="20">
									<path fill="currentColor" d="M8 5v14l11-7z" />
								</svg>
							</span>
						</button>
						<p class="video-kicker">{video.kicker}</p>
						<h3>
							<a href={`https://www.youtube.com/watch?v=${video.id}`} target="_blank" rel="noreferrer">{video.title}</a>
						</h3>
					</div>
				))}
			</div>
		</section>

		<section class="topics">
			<h2 class="section-title">Browse by Topic</h2>
			<div class="topic-grid">
				{topics.map((topic) => (
					<a href={topic.href} class="topic-chip">{topic.title}</a>
				))}
			</div>
		</section>

		<section class="more">
			<h2 class="section-title">More</h2>
			<div class="tiles">
				{more.map((tile) => (
					<a href={tile.href} class="tile">
						<p class="tile-kicker">{tile.kicker}</p>
						<h3>{tile.title}</h3>
						<p class="tile-description">{tile.description}</p>
						<span class="tile-arrow" aria-hidden="true">&rarr;</span>
					</a>
				))}
			</div>
		</section>
	</main>
</Layout>

<script>
	document.querySelectorAll<HTMLButtonElement>('.video-thumb[data-video-id]').forEach((thumb) => {
		thumb.addEventListener('click', () => {
			const id = thumb.dataset.videoId;
			if (!id) return;
			const iframe = document.createElement('iframe');
			iframe.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1`;
			iframe.title = thumb.getAttribute('aria-label') ?? 'YouTube video player';
			iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
			iframe.allowFullscreen = true;
			iframe.loading = 'lazy';
			iframe.className = 'video-embed';
			thumb.replaceWith(iframe);
		});
	});
</script>

<style>
	.shell {
		max-width: 1280px;
		margin: 0 auto;
		padding: 4rem 2rem 5rem;
	}

	.hero {
		margin-bottom: 3.5rem;
	}

	.kicker {
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--accent-strong);
		font-size: 0.78rem;
		font-weight: 600;
		margin: 0 0 0.75rem;
	}

	h1 {
		font-size: clamp(2.25rem, 5vw, 3.4rem);
		margin: 0;
		line-height: 1.05;
		letter-spacing: -0.01em;
	}

	.intro {
		margin-top: 1rem;
		max-width: 75ch;
		color: var(--text-muted);
		font-size: 1.08rem;
		line-height: 1.6;
	}

	.profile-strip {
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem;
		margin-top: 1.5rem;
	}

	.profile-strip a {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		padding: 0.45rem 0.85rem;
		border: 1px solid var(--border-strong);
		border-radius: 999px;
		background: var(--bg-raised);
		color: var(--text-muted);
		font-size: 0.82rem;
		font-weight: 600;
		text-decoration: none;
		transition: color 120ms ease, border-color 120ms ease, background 120ms ease;
	}

	.profile-strip a:hover {
		color: var(--text);
		border-color: var(--accent-strong);
		background: var(--bg-card);
	}

	.section-title {
		font-size: 0.78rem;
		font-weight: 600;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--text-dim);
		margin: 0 0 1rem;
	}

	.featured {
		margin-bottom: 3rem;
	}

	.videos {
		margin-bottom: 3rem;
	}

	.video-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1rem;
	}

	.video-card {
		display: block;
		text-decoration: none;
		color: inherit;
	}

	.video-thumb {
		display: block;
		width: 100%;
		position: relative;
		border-radius: 10px;
		overflow: hidden;
		border: 1px solid var(--border);
		background: var(--bg-raised);
		aspect-ratio: 16 / 9;
		padding: 0;
		font: inherit;
		cursor: pointer;
	}

	.video-thumb img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
		transition: transform 200ms ease;
	}

	.video-thumb:hover img {
		transform: scale(1.04);
	}

	.video-embed {
		display: block;
		width: 100%;
		aspect-ratio: 16 / 9;
		border-radius: 10px;
		border: 1px solid var(--border);
	}

	.play-icon {
		position: absolute;
		inset: 0;
		display: flex;
		align-items: center;
		justify-content: center;
		margin: auto;
		width: 2.75rem;
		height: 2.75rem;
		border-radius: 50%;
		background: rgba(0, 0, 0, 0.55);
		color: #fff;
		transition: background 130ms ease;
	}

	.video-thumb:hover .play-icon {
		background: var(--accent-strong);
	}

	.video-kicker {
		margin: 0.65rem 0 0.3rem;
		font-size: 0.7rem;
		font-weight: 700;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--accent-strong);
	}

	.video-card h3 {
		margin: 0;
		font-size: 0.92rem;
		font-weight: 600;
		line-height: 1.4;
	}

	.video-card h3 a {
		color: var(--text);
		text-decoration: none;
	}

	.video-card h3 a:hover {
		color: var(--accent-strong);
	}

	.latest {
		margin-bottom: 3rem;
	}

	.latest-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 1.1rem;
	}

	.latest-card {
		display: flex;
		gap: 1.1rem;
		border-bottom: 1px solid var(--border);
		padding-bottom: 1.1rem;
	}

	.latest-thumb-link {
		flex: 0 0 auto;
	}

	.latest-thumb {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 100px;
		height: 72px;
		object-fit: cover;
		border-radius: 8px;
		border: 1px solid var(--border);
		background: var(--bg-raised);
	}

	.latest-thumb-placeholder {
		color: var(--text-dim);
		border-style: dashed;
	}

	.latest-body {
		flex: 1;
		min-width: 0;
	}

	.latest-title {
		display: block;
		font-size: 1.05rem;
		font-weight: 600;
		text-decoration: none;
		color: var(--text);
		line-height: 1.4;
	}

	.latest-title:hover {
		color: var(--accent-strong);
	}

	.latest-meta {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 0.4rem;
		margin-top: 0.3rem;
		font-size: 0.78rem;
		color: var(--text-dim);
	}

	.latest-sep {
		opacity: 0.6;
	}

	.latest-category {
		color: var(--accent-strong);
		font-weight: 600;
	}

	.latest-excerpt {
		margin: 0.5rem 0 0;
		color: var(--text-muted);
		font-size: 0.92rem;
		line-height: 1.55;
	}

	.topics {
		margin-bottom: 3rem;
	}

	.topic-grid {
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem;
	}

	.topic-chip {
		display: inline-flex;
		align-items: center;
		padding: 0.55rem 1rem;
		background: var(--bg-card);
		border: 1px solid var(--border);
		border-radius: 999px;
		color: var(--text);
		text-decoration: none;
		font-size: 0.88rem;
		font-weight: 600;
		transition: border-color 130ms ease, background 130ms ease, color 130ms ease;
	}

	.topic-chip:hover {
		border-color: var(--accent-strong);
		color: var(--accent-strong);
		background: var(--bg-raised);
	}

	.featured-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1rem;
	}

	.featured-card {
		position: relative;
		display: flex;
		flex-direction: column;
		overflow: hidden;
		background: linear-gradient(180deg, var(--card-gradient-top), var(--card-gradient-bottom));
		border: 1px solid var(--border-strong);
		border-radius: 14px;
		color: inherit;
		transition: border-color 130ms ease, background 130ms ease;
	}

	.featured-image {
		display: block;
		width: 100%;
		height: 140px;
		object-fit: cover;
		object-position: top;
		border-bottom: 1px solid var(--border);
		background: var(--bg-raised);
	}

	.featured-card > :not(.featured-image) {
		padding-left: 1.5rem;
		padding-right: 1.5rem;
	}

	.featured-card > .featured-kicker {
		margin-top: 1.25rem;
	}

	.featured-card > .featured-links {
		padding-bottom: 1.5rem;
	}

	.featured-card:hover {
		border-color: var(--accent-strong);
		background: linear-gradient(180deg, var(--card-gradient-top-hover), var(--card-gradient-bottom-hover));
	}

	.featured-links {
		padding-top: 1rem;
		display: flex;
		align-items: center;
		gap: 1rem;
	}

	.featured-links a {
		display: inline-flex;
		align-items: center;
		gap: 0.3rem;
		font-size: 0.82rem;
		font-weight: 600;
		text-decoration: none;
		color: var(--text-dim);
	}

	.featured-links a:hover {
		color: var(--text);
	}

	.featured-links .external-icon {
		flex: 0 0 auto;
		opacity: 0.6;
	}

	.featured-links a:hover .external-icon {
		opacity: 1;
	}

	.featured-live-link {
		color: var(--accent-strong) !important;
	}

	.featured-live-link:hover {
		color: var(--accent) !important;
	}

	.featured-kicker {
		font-size: 0.7rem;
		font-weight: 700;
