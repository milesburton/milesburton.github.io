---
import Layout from '../layouts/Layout.astro';

const featured = [
	{
		href: 'https://github.com/milesburton/Arduino-Temperature-Control-Library',
		external: true,
		image: '/images/projects/arduino-dashboard.jpg',
		imageAlt: 'Live sensor data dashboard showing a temperature graph over time',
		kicker: 'Open Source · 1k+ stars',
		title: 'Arduino Temperature Control Library',
		description: 'The de-facto Arduino/ESP32 library for Maxim/Dallas 1-Wire temperature sensors (DS18B20 and family). Widely used across the embedded hobbyist and IoT ecosystem.',
		tags: ['C++', 'Embedded', '1-Wire'],
	},
	{
		href: 'https://github.com/milesburton/veta-trading-platform',
		external: true,
		liveHref: 'https://veta.mnetcs.com/',
		image: '/images/projects/veta-dashboard.jpg',
		imageAlt: 'Veta trading terminal showing a live market ladder, orders, and positions panels',
		kicker: 'Finance · In progress',
		title: 'Veta Trading Platform',
		description: 'A near-real-world trading platform for paper-trading algorithmic strategies against simulated and real market data — built to help people learn market dynamics without risking capital.',
		tags: ['TypeScript', 'Trading', 'WIP'],
	},
	{
		href: 'https://github.com/milesburton/teslacam',
		external: true,
		image: '/images/projects/teslacam.jpg',
		imageAlt: 'Tesla center console showing dash-cam footage on screen with a laptop running the TeslaCam software',
		kicker: 'Open Source · 100+ stars',
		title: 'TeslaCam',
		description: 'Automates backup, cloud storage, and remote access for Tesla dash-cam footage using a Raspberry Pi Zero W.',
		tags: ['JavaScript', 'Raspberry Pi', 'Automation'],
	},
];

const more = [
	{
		href: '/projects/',
		kicker: 'Engineering',
		title: 'All Projects',
		description: 'The rest of the open-source libraries and systems I maintain.',
	},
	{
		href: '/blog/',
		kicker: 'Writing',
		title: 'Blog',
		description: 'Notes on infrastructure, embedded electronics, and networking.',
	},
	{
		href: '/wiki/Main_Page/',
		kicker: 'Reference',
		title: 'Wiki & Notes',
		description: 'A long-running personal knowledge base, being consolidated here.',
	},
	{
		href: '/contact/',
		kicker: 'Contact',
		title: 'Get in touch',
		description: 'Reach out about engineering work, collaboration, or anything here.',
	},
];
---

<Layout>
	<main class="shell">
		<header class="hero">
			<p class="kicker">Software Engineer</p>
			<h1>Miles Burton</h1>
			<p class="intro">
				Projects, writing, and reference notes. Mostly infrastructure and embedded systems.
			</p>
			<p class="wip-note">
				This site is a work in progress as I migrate content over from my old blog and wiki.
			</p>
		</header>

		<section class="featured">
			<h2 class="section-title">Featured Projects</h2>
			<div class="featured-grid">
				{featured.map((project) => (
					<div class="featured-card">
						<img src={project.image} alt={project.imageAlt} class="featured-image" loading="lazy" />
						<p class="featured-kicker">{project.kicker}</p>
						<h3>{project.title}</h3>
						<p class="featured-description">{project.description}</p>
						<ul class="tags">
							{project.tags.map((tag) => (
								<li>{tag}</li>
							))}
						</ul>
						<div class="featured-links">
							<a href={project.href} target={project.external ? '_blank' : undefined} rel={project.external ? 'noreferrer' : undefined}>
								Source
							</a>
							{project.liveHref && (
								<a href={project.liveHref} target="_blank" rel="noreferrer" class="featured-live-link">
									Live site &rarr;
								</a>
							)}
						</div>
					</div>
				))}
			</div>
		</section>

		<section class="more">
			<h2 class="section-title">More</h2>
			<div class="tiles">
				{more.map((tile) => (
					<a href={tile.href} class="tile">
						<p class="tile-kicker">{tile.kicker}</p>
						<h3>{tile.title}</h3>
						<p class="tile-description">{tile.description}</p>
						<span class="tile-arrow" aria-hidden="true">&rarr;</span>
					</a>
				))}
			</div>
		</section>
	</main>
</Layout>

<style>
	.shell {
		max-width: 1000px;
		margin: 0 auto;
		padding: 4rem 2rem 5rem;
	}

	.hero {
		margin-bottom: 3.5rem;
	}

	.kicker {
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--accent-strong);
		font-size: 0.78rem;
		font-weight: 600;
		margin: 0 0 0.75rem;
	}

	h1 {
		font-size: clamp(2.25rem, 5vw, 3.4rem);
		margin: 0;
		line-height: 1.05;
		letter-spacing: -0.01em;
	}

	.intro {
		margin-top: 1rem;
		max-width: 58ch;
		color: var(--text-muted);
		font-size: 1.08rem;
		line-height: 1.6;
	}

	.wip-note {
		margin-top: 0.75rem;
		max-width: 58ch;
		color: var(--text-dim);
		font-size: 0.85rem;
	}

	.section-title {
		font-size: 0.78rem;
		font-weight: 600;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--text-dim);
		margin: 0 0 1rem;
	}

	.featured {
		margin-bottom: 3rem;
	}

	.featured-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1rem;
	}

	.featured-card {
		position: relative;
		display: flex;
		flex-direction: column;
		overflow: hidden;
		background: linear-gradient(180deg, rgba(56, 189, 248, 0.07), rgba(15, 23, 42, 0.4));
		border: 1px solid var(--border-strong);
		border-radius: 14px;
		color: inherit;
		transition: border-color 130ms ease, background 130ms ease;
	}

	.featured-image {
		display: block;
		width: 100%;
		height: 140px;
		object-fit: cover;
		object-position: top;
		border-bottom: 1px solid var(--border);
		background: var(--bg-raised);
	}

	.featured-card > :not(.featured-image) {
		padding-left: 1.5rem;
		padding-right: 1.5rem;
	}

	.featured-card > .featured-kicker {
		margin-top: 1.25rem;
	}

	.featured-card > .featured-links {
		padding-bottom: 1.5rem;
	}

	.featured-card:hover {
		border-color: var(--accent-strong);
		background: linear-gradient(180deg, rgba(56, 189, 248, 0.12), rgba(15, 23, 42, 0.5));
	}

	.featured-links {
		margin-top: auto;
		padding-top: 1rem;
		display: flex;
		align-items: center;
		gap: 1rem;
	}

	.featured-links a {
		font-size: 0.82rem;
		font-weight: 600;
		text-decoration: none;
		color: var(--text-dim);
	}

	.featured-links a:hover {
		color: var(--text);
	}

	.featured-live-link {
		color: var(--accent-strong) !important;
	}

	.featured-live-link:hover {
		color: var(--accent) !important;
	}

	.featured-kicker {
		font-size: 0.7rem;
		font-weight: 700;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--accent-strong);
		margin: 0 0 0.6rem;
	}

	.featured-card h3 {
		margin: 0 0 0.6rem;
		font-size: 1.1rem;
		color: var(--text);
		line-height: 1.3;
	}

	.featured-description {
		margin: 0 0 1rem;
		color: var(--text-muted);
		font-size: 0.88rem;
		line-height: 1.55;
	}

	.tags {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
	}

	.tags li {
		font-size: 0.68rem;
		font-weight: 600;
		letter-spacing: 0.03em;
		color: var(--text-dim);
		background: var(--bg-raised);
		border: 1px solid var(--border);
		border-radius: 999px;
		padding: 0.15rem 0.55rem;
	}

	.tiles {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 1rem;
	}

	.tile {
		position: relative;
		display: block;
		background: var(--bg-card);
		border: 1px solid var(--border);
		border-radius: 12px;
		padding: 1.25rem 1.5rem 1.5rem;
		text-decoration: none;
		color: inherit;
		transition: transform 130ms ease, border-color 130ms ease, background 130ms ease;
	}

	.tile:hover {
		transform: translateY(-2px);
		border-color: var(--border-strong);
		background: var(--bg-raised);
	}

	.tile-kicker {
		font-size: 0.72rem;
		font-weight: 600;
		letter-spacing: 0.09em;
		text-transform: uppercase;
		color: var(--text-dim);
		margin: 0 0 0.5rem;
	}

	.tile h3 {
		margin: 0 0 0.5rem;
		font-size: 1.05rem;
		color: var(--text);
	}

	.tile-description {
		margin: 0;
		color: var(--text-muted);
		font-size: 0.88rem;
		line-height: 1.5;
	}

	.tile-arrow {
		position: absolute;
		top: 1.25rem;
		right: 1.5rem;
		color: var(--text-dim);
		transition: transform 130ms ease, color 130ms ease;
	}

	.tile:hover .tile-arrow {
		transform: translateX(3px);
		color: var(--accent-strong);
	}

	@media (max-width: 760px) {
		.featured-grid {
			grid-template-columns: 1fr;
		}
	}

	@media (max-width: 620px) {
		.tiles {
			grid-template-columns: 1fr;
		}

		.shell {
			padding: 2.5rem 1.25rem 3rem;
		}
	}
</style>
