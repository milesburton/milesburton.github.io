---
import Layout from '../../layouts/Layout.astro';
import Carousel from '../../components/Carousel.astro';
import PageHeader from '../../components/PageHeader.astro';
import { getCollection } from 'astro:content';
import { formatDate } from '../../lib/format';
import { getHeroImage } from '../../lib/posts';

const allPosts = await getCollection('blog');
const posts = allPosts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const featured = [
	{ slug: 'currents-of-change-a-first-hand-look-at-sainsburys-crayford-ev-charging-haven', image: '/blog-media/2023/11/img_9354.jpg', alt: 'A Tesla charging at a row of ultra-rapid EV chargers in a Sainsbury\'s car park' },
	{ slug: 'can-a-mystery-aliexpress-server-be-any-good-intel-n100-16gig-1tssd-6x-i226-2-5g', image: '/blog-media/2024/07/server.jpg', alt: 'Close-up of a mini server\'s rear panel showing six ethernet ports and a large heatsink' },
	{ slug: 'building-your-own-24-7-retro-gaming-kiosk-with-the-raspberry-pi', image: '/blog-media/2025/01/img_1339.jpg', alt: 'A small Raspberry Pi-powered arcade screen playing Double Dragon V, sat on a shelf of retro game consoles' },
	{ slug: '2299', image: '/blog-media/2025/01/img_1323.jpg', alt: 'An LED matrix panel displaying a game of Pong next to a keyboard and mouse' },
	{ slug: 'approaching-the-foundation-licence-amatuer-radio', image: '/blog-media/2016/05/front.png', alt: 'Cover slide for a presentation on approaching the UK amateur radio Foundation Licence' },
	{ slug: 'barking-recycling-plant-engulfed-in-fire', image: '/blog-media/2018/06/img_4517.jpg', alt: 'Thick black smoke rising from a fire at a recycling plant, seen across the River Thames' },
]
	.map((item) => {
		const post = posts.find((p) => p.data.slug === item.slug);
		return post ? { ...item, title: post.data.title, href: `/blog/${post.data.slug}/` } : null;
	})
	.filter((item): item is NonNullable<typeof item> => item !== null);

const carouselSlides = featured.map((item) => ({
	href: item.href,
	image: item.image,
	alt: item.alt,
	caption: item.title,
}));
---

<Layout title="Blog" description="Writing on infrastructure, embedded electronics, and networking by Miles Burton.">
	<main class="shell">
		<PageHeader kicker="Writing" title="Blog" />

		<Carousel id="blog-carousel" slides={carouselSlides} />

		<ul class="post-list">
			{posts.map((post) => {
				const image = getHeroImage(post);
				return (
					<li class="post-card">
						<a href={`/blog/${post.data.slug}/`} class="post-thumb-link" tabindex="-1" aria-hidden="true">
							{image ? (
								<img src={image} alt="" class="post-thumb" loading="lazy" />
							) : (
								<span class="post-thumb post-thumb-placeholder">
									<svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
										<rect x="3" y="3" width="18" height="18" rx="2" fill="none" stroke="currentColor" stroke-width="1.5" />
										<circle cx="8.5" cy="8.5" r="1.5" fill="currentColor" />
										<path d="M21 15l-5-5-9 9" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
									</svg>
								</span>
							)}
						</a>
						<div class="post-body">
							<a href={`/blog/${post.data.slug}/`} class="post-title">
								{post.data.title}
							</a>
							<time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
							{post.data.excerpt && <p class="post-excerpt">{post.data.excerpt}</p>}
							{post.data.tags.length > 0 && (
								<ul class="post-tags">
									{post.data.tags.map((tag) => (
										<li>{tag}</li>
									))}
								</ul>
							)}
						</div>
					</li>
				);
			})}
		</ul>
	</main>
</Layout>

<style>

	.post-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 1.1rem;
	}

	.post-card {
		display: flex;
		gap: 1.1rem;
		border-bottom: 1px solid var(--border);
		padding-bottom: 1.1rem;
	}

	.post-thumb-link {
		flex: 0 0 auto;
	}

	.post-thumb {
		display: block;
		width: 100px;
		height: 72px;
		object-fit: cover;
		border-radius: 8px;
		border: 1px solid var(--border);
		background: var(--bg-raised);
	}

	.post-thumb-placeholder {
		display: flex;
		align-items: center;
		justify-content: center;
		color: var(--text-dim);
		border-style: dashed;
	}

	.post-body {
		flex: 1;
		min-width: 0;
	}

	.post-title {
		display: block;
		font-size: 1.05rem;
		font-weight: 600;
		text-decoration: none;
		color: var(--text);
		line-height: 1.4;
	}

	.post-title:hover {
		color: var(--accent-strong);
	}

	time {
		display: block;
		margin-top: 0.3rem;
		font-size: 0.78rem;
		color: var(--text-dim);
	}

	.post-excerpt {
		margin: 0.5rem 0 0;
		color: var(--text-muted);
		font-size: 0.92rem;
		line-height: 1.55;
	}

	.post-tags {
		list-style: none;
		margin: 0.6rem 0 0;
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
	}

	.post-tags li {
		font-size: 0.68rem;
		font-weight: 600;
		letter-spacing: 0.03em;
		color: var(--text-dim);
		background: var(--bg-raised);
		border: 1px solid var(--border);
		border-radius: 999px;
		padding: 0.15rem 0.55rem;
	}

	@media (max-width: 560px) {
		.post-thumb {
			width: 72px;
			height: 72px;
		}
	}
</style>
