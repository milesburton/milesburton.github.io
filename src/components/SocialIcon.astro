---
// Shared brand/utility icon set used in the footer, the homepage profile
// strip, and inline external links -- kept as one component so a visual
// tweak doesn't need to be repeated by hand in every place an icon appears.
type IconName = 'linkedin' | 'github' | 'youtube' | 'contact' | 'external-link';

interface Props {
	name: IconName;
	size?: number;
	class?: string;
}

const { name, size = 15, class: className } = Astro.props;
---

{name === 'linkedin' && (
	<svg viewBox="0 0 24 24" width={size} height={size} aria-hidden="true" class={className}>
		<path
			fill="currentColor"
			d="M20.45 20.45h-3.56v-5.57c0-1.33-.03-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.34V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.38-1.85 3.61 0 4.28 2.38 4.28 5.47v6.27zM5.34 7.43a2.07 2.07 0 1 1 0-4.13 2.07 2.07 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56v11.45z"
		/>
	</svg>
)}

{name === 'github' && (
	<svg viewBox="0 0 24 24" width={size} height={size} aria-hidden="true" class={className}>
		<path
			fill="currentColor"
			d="M12 .5C5.73.5.5 5.73.5 12c0 5.09 3.29 9.4 7.86 10.93.58.1.79-.25.79-.56 0-.27-.01-1.17-.02-2.12-3.2.7-3.88-1.36-3.88-1.36-.52-1.33-1.28-1.68-1.28-1.68-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.03 1.75 2.7 1.25 3.36.96.1-.75.4-1.25.73-1.53-2.55-.29-5.24-1.28-5.24-5.68 0-1.25.45-2.28 1.18-3.08-.12-.29-.51-1.46.11-3.04 0 0 .96-.31 3.15 1.18a10.9 10.9 0 0 1 5.74 0c2.19-1.49 3.15-1.18 3.15-1.18.62 1.58.23 2.75.11 3.04.73.8 1.18 1.83 1.18 3.08 0 4.41-2.69 5.38-5.25 5.67.41.36.78 1.07.78 2.15 0 1.55-.01 2.8-.01 3.18 0 .31.21.67.8.56A10.52 10.52 0 0 0 23.5 12C23.5 5.73 18.27.5 12 .5z"
		/>
	</svg>
)}

{name === 'youtube' && (
	<svg viewBox="0 0 24 24" width={size} height={size} aria-hidden="true" class={className}>
		<path
			fill="currentColor"
			d="M23.5 6.19a3.02 3.02 0 0 0-2.12-2.14C19.5 3.5 12 3.5 12 3.5s-7.5 0-9.38.55A3.02 3.02 0 0 0 .5 6.19 31.6 31.6 0 0 0 0 12a31.6 31.6 0 0 0 .5 5.81 3.02 3.02 0 0 0 2.12 2.14c1.88.55 9.38.55 9.38.55s7.5 0 9.38-.55a3.02 3.02 0 0 0 2.12-2.14A31.6 31.6 0 0 0 24 12a31.6 31.6 0 0 0-.5-5.81zM9.55 15.57V8.43L15.82 12l-6.27 3.57z"
		/>
	</svg>
)}

{name === 'contact' && (
	<svg viewBox="0 0 24 24" width={size} height={size} aria-hidden="true" class={className}>
		<path
			fill="none"
			stroke="currentColor"
			stroke-width="1.6"
			stroke-linecap="round"
			stroke-linejoin="round"
			d="M3 6.5A1.5 1.5 0 0 1 4.5 5h15A1.5 1.5 0 0 1 21 6.5v11a1.5 1.5 0 0 1-1.5 1.5h-15A1.5 1.5 0 0 1 3 17.5v-11z M3.5 6.5l8.5 6 8.5-6"
		/>
	</svg>
)}

{name === 'external-link' && (
	<svg viewBox="0 0 24 24" width={size} height={size} aria-hidden="true" class={className}>
		<path
			fill="none"
			stroke="currentColor"
			stroke-width="2"
			stroke-linecap="round"
			stroke-linejoin="round"
			d="M7 17L17 7M9 7h8v8"
		/>
	</svg>
)}
