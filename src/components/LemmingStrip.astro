---
interface Props {
	count?: number;
}

const { count = 3 } = Astro.props;
const lemmings = Array.from({ length: count }, (_, i) => i);
---

<div class="lemming-strip" aria-hidden="true">
	{lemmings.map((i) => (
		<div class="lemming" style={`--delay: ${i * 5}s;`}>
			<div class="lemming-sprite frame-a"></div>
			<div class="lemming-sprite frame-b"></div>
		</div>
	))}
</div>

<style>
	.lemming-strip {
		position: absolute;
		inset: 0;
		overflow: hidden;
		pointer-events: none;
	}

	.lemming {
		position: absolute;
		bottom: 6px;
		left: -20px;
		width: 10px;
		height: 12px;
		transform: scale(2.2);
		transform-origin: bottom left;
		animation: march 9s linear infinite;
		animation-delay: var(--delay, 0s);
	}

	.lemming-sprite {
		position: absolute;
		inset: 0;
		image-rendering: pixelated;
		animation: blink-frame 0.4s steps(1) infinite;
	}

	.frame-a {
		animation-name: show-a;
	}

	.frame-b {
		animation-name: show-b;
	}

	@keyframes show-a {
		0%,
		49% {
			opacity: 1;
		}
		50%,
		100% {
			opacity: 0;
		}
	}

	@keyframes show-b {
		0%,
		49% {
			opacity: 0;
		}
		50%,
		100% {
			opacity: 1;
		}
	}

	/* pixel-art lemming, walking pose A (legs apart) */
	.frame-a {
		box-shadow:
			3px 0 0 0 #4ade80,
			4px 0 0 0 #4ade80,
			2px 1px 0 0 #fbbf24,
			3px 1px 0 0 #fbbf24,
			4px 1px 0 0 #fbbf24,
			5px 1px 0 0 #fbbf24,
			2px 2px 0 0 #fbbf24,
			3px 2px 0 0 #1e293b,
			4px 2px 0 0 #1e293b,
			5px 2px 0 0 #fbbf24,
			2px 3px 0 0 #f97316,
			3px 3px 0 0 #38bdf8,
			4px 3px 0 0 #38bdf8,
			5px 3px 0 0 #f97316,
			1px 4px 0 0 #38bdf8,
			2px 4px 0 0 #38bdf8,
			3px 4px 0 0 #38bdf8,
			4px 4px 0 0 #38bdf8,
			5px 4px 0 0 #38bdf8,
			6px 4px 0 0 #38bdf8,
			1px 5px 0 0 #38bdf8,
			2px 5px 0 0 #38bdf8,
			3px 5px 0 0 #38bdf8,
			4px 5px 0 0 #38bdf8,
			5px 5px 0 0 #38bdf8,
			6px 5px 0 0 #38bdf8,
			2px 6px 0 0 #38bdf8,
			3px 6px 0 0 #38bdf8,
			4px 6px 0 0 #38bdf8,
			5px 6px 0 0 #38bdf8,
			1px 7px 0 0 #1e293b,
			2px 7px 0 0 #1e293b,
			5px 7px 0 0 #1e293b,
			6px 7px 0 0 #1e293b,
			0px 8px 0 0 #1e293b,
			1px 8px 0 0 #1e293b,
			6px 8px 0 0 #1e293b,
			7px 8px 0 0 #1e293b;
	}

	/* pixel-art lemming, walking pose B (legs together) */
	.frame-b {
		box-shadow:
			3px 0 0 0 #4ade80,
			4px 0 0 0 #4ade80,
			2px 1px 0 0 #fbbf24,
			3px 1px 0 0 #fbbf24,
			4px 1px 0 0 #fbbf24,
			5px 1px 0 0 #fbbf24,
			2px 2px 0 0 #fbbf24,
			3px 2px 0 0 #1e293b,
			4px 2px 0 0 #1e293b,
			5px 2px 0 0 #fbbf24,
			2px 3px 0 0 #f97316,
			3px 3px 0 0 #38bdf8,
			4px 3px 0 0 #38bdf8,
			5px 3px 0 0 #f97316,
			1px 4px 0 0 #38bdf8,
			2px 4px 0 0 #38bdf8,
			3px 4px 0 0 #38bdf8,
			4px 4px 0 0 #38bdf8,
			5px 4px 0 0 #38bdf8,
			6px 4px 0 0 #38bdf8,
			1px 5px 0 0 #38bdf8,
			2px 5px 0 0 #38bdf8,
			3px 5px 0 0 #38bdf8,
			4px 5px 0 0 #38bdf8,
			5px 5px 0 0 #38bdf8,
			6px 5px 0 0 #38bdf8,
			2px 6px 0 0 #38bdf8,
			3px 6px 0 0 #38bdf8,
			4px 6px 0 0 #38bdf8,
			5px 6px 0 0 #38bdf8,
			2px 7px 0 0 #1e293b,
			3px 7px 0 0 #1e293b,
			4px 7px 0 0 #1e293b,
			5px 7px 0 0 #1e293b,
			2px 8px 0 0 #1e293b,
			3px 8px 0 0 #1e293b,
			4px 8px 0 0 #1e293b,
			5px 8px 0 0 #1e293b;
	}

	@keyframes march {
		from {
			left: -20px;
		}
		to {
			left: 100%;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.lemming-strip {
			display: none;
		}
	}
</style>
