---
import SiteFooter from '../components/SiteFooter.astro';
import SiteSearch from '../components/SiteSearch.astro';

interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'Miles Burton',
	description = 'Software engineer working on trading systems, infrastructure, and embedded projects.',
} = Astro.props;

const nav = [
	{ href: '/', label: 'Home' },
	{ href: '/now/', label: 'Now' },
	{ href: '/projects/', label: 'GitHub Projects' },
	{ href: '/blog/', label: 'Blog' },
	{ href: '/wiki/Main_Page/', label: 'Wiki' },
	{ href: '/amateur-radio/', label: 'Amateur Radio' },
	{ href: 'https://www.youtube.com/@M0LHA', label: 'YouTube', external: true },
	{ href: 'https://github.com/milesburton', label: 'GitHub', external: true },
	{ href: 'https://www.linkedin.com/in/milesburton/', label: 'LinkedIn', external: true },
	{ href: '/contact/', label: 'Contact' },
];

const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" href="https://avatars.githubusercontent.com/u/1205171?s=400&u=812ae0dcddc153c8d8776609f2f557f731822afa&v=4" />
		<meta name="generator" content={Astro.generator} />
		<title>{title} | milesburton.com</title>
		<meta name="description" content={description} />
		<script is:inline>
			(function () {
				var stored = localStorage.getItem('theme');
				if (stored === 'light' || stored === 'dark') {
					document.documentElement.setAttribute('data-theme', stored);
				}
			})();
		</script>
	</head>
	<body>
		<div class="page">
			<div class="frame">
				<aside class="sidebar">
					<a href="/" class="brand">
						<img src="https://avatars.githubusercontent.com/u/1205171?s=400&u=812ae0dcddc153c8d8776609f2f557f731822afa&v=4" alt="" class="avatar" />
						<span>Miles Burton</span>
					</a>
					<SiteSearch />
					<nav>
						<ul>
							{nav.map((item) => (
								<li>
									<a
										href={item.href}
										target={item.external ? '_blank' : undefined}
										rel={item.external ? 'noreferrer' : undefined}
										aria-current={!item.external && (currentPath === item.href || currentPath.startsWith(item.href) && item.href !== '/') ? 'page' : undefined}
										class={item.external ? 'external' : undefined}
									>
										{item.label}
										{item.external && (
											<svg class="external-icon" viewBox="0 0 24 24" width="12" height="12" aria-hidden="true">
												<path
													fill="none"
													stroke="currentColor"
													stroke-width="2"
													stroke-linecap="round"
													stroke-linejoin="round"
													d="M7 17L17 7M9 7h8v8"
												/>
											</svg>
										)}
									</a>
								</li>
							))}
						</ul>
					</nav>
				</aside>
				<div class="content-area">
					<slot />
				</div>
			</div>
			<SiteFooter />
		</div>
	</body>
</html>

<style is:global>
	:root,
	:root[data-theme='dark'] {
		--bg: #05070d;
		--bg-raised: #0b1120;
		--bg-card: #0f172a;
		--border: rgba(148, 163, 184, 0.16);
		--border-strong: rgba(148, 163, 184, 0.32);
		--text: #e2e8f0;
		--text-muted: #94a3b8;
		--text-dim: #64748b;
		--text-body: #cbd5e1;
		--accent: #38bdf8;
		--accent-strong: #7dd3fc;
		--row-stripe: rgba(148, 163, 184, 0.04);
		--nav-active-bg: rgba(56, 189, 248, 0.1);
		--overlay-backdrop: rgba(2, 6, 15, 0.7);
		--overlay-shadow: rgba(0, 0, 0, 0.5);
		--card-gradient-top: rgba(56, 189, 248, 0.07);
		--card-gradient-top-hover: rgba(56, 189, 248, 0.12);
		--card-gradient-bottom: rgba(15, 23, 42, 0.4);
		--card-gradient-bottom-hover: rgba(15, 23, 42, 0.5);
		--highlight-bg: rgba(56, 189, 248, 0.25);
		color-scheme: dark;
		font-family: 'IBM Plex Sans', 'Segoe UI', system-ui, sans-serif;
	}

	:root[data-theme='light'] {
		--bg: #f8fafc;
		--bg-raised: #eef2f7;
		--bg-card: #ffffff;
		--border: rgba(15, 23, 42, 0.1);
		--border-strong: rgba(15, 23, 42, 0.18);
		--text: #0f172a;
		--text-muted: #475569;
		--text-dim: #64748b;
		--text-body: #334155;
		--accent: #0284c7;
		--accent-strong: #0369a1;
		--row-stripe: rgba(15, 23, 42, 0.025);
		--nav-active-bg: rgba(2, 132, 199, 0.1);
		--overlay-backdrop: rgba(15, 23, 42, 0.35);
		--overlay-shadow: rgba(15, 23, 42, 0.25);
		--card-gradient-top: rgba(2, 132, 199, 0.06);
		--card-gradient-top-hover: rgba(2, 132, 199, 0.1);
		--card-gradient-bottom: rgba(255, 255, 255, 0.6);
		--card-gradient-bottom-hover: rgba(255, 255, 255, 0.8);
		--highlight-bg: rgba(2, 132, 199, 0.2);
		color-scheme: light;
	}

	@media (prefers-color-scheme: light) {
		:root:not([data-theme]) {
			--bg: #f8fafc;
			--bg-raised: #eef2f7;
			--bg-card: #ffffff;
			--border: rgba(15, 23, 42, 0.1);
			--border-strong: rgba(15, 23, 42, 0.18);
			--text: #0f172a;
			--text-muted: #475569;
			--text-dim: #64748b;
			--text-body: #334155;
			--accent: #0284c7;
			--accent-strong: #0369a1;
			--row-stripe: rgba(15, 23, 42, 0.025);
			--nav-active-bg: rgba(2, 132, 199, 0.1);
			--overlay-backdrop: rgba(15, 23, 42, 0.35);
			--overlay-shadow: rgba(15, 23, 42, 0.25);
			--card-gradient-top: rgba(2, 132, 199, 0.06);
			--card-gradient-top-hover: rgba(2, 132, 199, 0.1);
			--card-gradient-bottom: rgba(255, 255, 255, 0.6);
			--card-gradient-bottom-hover: rgba(255, 255, 255, 0.8);
			--highlight-bg: rgba(2, 132, 199, 0.2);
			color-scheme: light;
		}
	}

	:root {
		--footer-height: 48px;
	}

	@media (max-width: 620px) {
		:root {
			--footer-height: 76px;
		}
	}

	* {
		box-sizing: border-box;
	}

	html,
	body {
		margin: 0;
		width: 100%;
		min-height: 100%;
		background: var(--bg);
		color: var(--text);
	}

	body {
		font-family: 'IBM Plex Sans', 'Segoe UI', system-ui, sans-serif;
		line-height: 1.5;
	}

	a {
		color: inherit;
	}

	code, pre {
		font-family: 'IBM Plex Mono', 'SFMono-Regular', Consolas, monospace;
	}

	/* Markdown content rendered directly via `layout:` frontmatter (e.g. wiki pages)
	   has no wrapping component to scope styles to, so style it globally here. */
	.content-area:has(> h1) {
		max-width: 720px;
		margin: 0 auto;
		padding: 3rem 2rem 5rem;
		display: block;
	}

	.content-area h1 {
		font-size: clamp(1.9rem, 4vw, 2.6rem);
		margin: 0 0 1.5rem;
		line-height: 1.2;
	}

	.content-area h1 + p.wiki-date,
	.content-area h1 + span.wiki-section-badge + p.wiki-date {
		margin: -1.1rem 0 1.5rem;
		font-size: 0.82rem;
		color: var(--text-dim);
	}

	.content-area .wiki-section-badge {
		display: inline-block;
		margin: -1.1rem 0 0.5rem;
		font-size: 0.7rem;
		font-weight: 700;
		letter-spacing: 0.05em;
		text-transform: uppercase;
		color: var(--accent-strong);
		background: var(--nav-active-bg);
		border-radius: 999px;
		padding: 0.2rem 0.65rem;
	}

	.content-area h2,
	.content-area h3,
	.content-area h4 {
		margin: 2rem 0 0.75rem;
		line-height: 1.3;
		color: var(--text);
	}

	.content-area p {
		margin: 0 0 1.1rem;
		color: var(--text-body);
		line-height: 1.65;
	}

	.content-area a {
		color: var(--accent-strong);
	}

	.image-placeholder {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		padding: 0.3rem 0.65rem;
		margin: 0.15rem 0;
		background: var(--bg-card);
		border: 1px dashed var(--border-strong);
		border-radius: 6px;
		color: var(--text-dim);
		font-size: 0.8rem;
		font-style: normal;
		cursor: help;
	}

	.image-placeholder svg {
		flex: 0 0 auto;
		opacity: 0.7;
	}

	.content-area ul,
	.content-area ol {
		margin: 0 0 1.1rem;
		padding-left: 1.4rem;
		color: var(--text-body);
	}

	.content-area li {
		margin-bottom: 0.4rem;
	}

	.content-area img {
		max-width: 100%;
		height: auto;
		border-radius: 8px;
	}

	.content-area blockquote {
		margin: 1.25rem 0;
		padding: 0.25rem 1.25rem;
		border-left: 3px solid var(--border-strong);
		color: var(--text-muted);
	}

	.content-area pre {
		background: var(--bg-card);
		border: 1px solid var(--border);
		border-radius: 8px;
		padding: 1rem;
		overflow-x: auto;
	}

	.content-area code {
		background: var(--bg-card);
		border-radius: 4px;
		padding: 0.1rem 0.35rem;
		font-size: 0.9em;
	}

	.content-area pre code {
		background: none;
		padding: 0;
	}

	.content-area table {
		width: 100%;
		border-collapse: collapse;
		margin: 1.25rem 0;
		font-size: 0.92rem;
	}

	.content-area th,
	.content-area td {
		border: 1px solid var(--border);
		padding: 0.6rem 0.85rem;
		text-align: left;
		vertical-align: top;
	}

	.content-area th {
		background: var(--bg-card);
		color: var(--text);
		font-weight: 600;
	}

	.content-area tr:nth-child(even) td {
		background: var(--row-stripe);
	}
</style>

<style>
	.page {
		display: flex;
		flex-direction: column;
		min-height: 100vh;
	}

	.frame {
		display: flex;
		flex: 1;
		width: 100%;
		max-width: 1280px;
		margin: 0 auto;
		padding-bottom: var(--footer-height);
	}

	.sidebar {
		flex: 0 0 240px;
		display: flex;
		flex-direction: column;
		padding: 2rem 1.25rem;
		border-right: 1px solid var(--border);
		position: sticky;
		top: 0;
		align-self: flex-start;
		max-height: calc(100vh - var(--footer-height));
	}

	.brand {
		display: flex;
		align-items: center;
		gap: 0.65rem;
		text-decoration: none;
		font-weight: 600;
		font-size: 1.02rem;
		color: var(--text);
		margin-bottom: 2.25rem;
	}

	.avatar {
		width: 34px;
		height: 34px;
		border-radius: 50%;
		border: 1px solid var(--border-strong);
	}

	nav ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 0.15rem;
	}

	nav a {
		display: flex;
		align-items: center;
		gap: 0.35rem;
		padding: 0.5rem 0.65rem;
		border-radius: 6px;
		text-decoration: none;
		color: var(--text-muted);
		font-size: 0.92rem;
		font-weight: 500;
		transition: background 120ms ease, color 120ms ease;
	}

	nav a:hover {
		background: var(--bg-raised);
		color: var(--text);
	}

	nav a[aria-current='page'] {
		background: var(--nav-active-bg);
		color: var(--accent-strong);
	}

	.external-icon {
		flex: 0 0 auto;
		opacity: 0.6;
	}

	nav a:hover .external-icon {
		opacity: 1;
	}

	.content-area {
		flex: 1;
		min-width: 0;
	}

	@media (max-width: 860px) {
		.frame {
			flex-direction: column;
		}

		.sidebar {
			position: static;
			height: auto;
			flex-direction: row;
			flex-wrap: wrap;
			align-items: center;
			border-right: none;
			border-bottom: 1px solid var(--border);
			padding: 1rem 1.25rem;
		}

		.brand {
			margin-bottom: 0;
			margin-right: auto;
		}

		nav ul {
			flex-direction: row;
			flex-wrap: wrap;
		}
	}
</style>
